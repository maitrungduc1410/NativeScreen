<Window
    x:Class="NativeScreen.App.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Native Screen">
    <Grid x:Name="Root" Background="{ThemeResource SurfaceCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="DragBar" Background="Transparent" />
        <Grid Grid.Row="1" Padding="24,0,24,24" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="14">
                <TextBlock Text="Native Screen" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource Ink95}" />
                <TextBlock Text="100% Native Windows &amp; Direct3D Engine • 0% Idle CPU" FontSize="12.5" Foreground="{ThemeResource Ink60}" TextWrapping="Wrap" Margin="0,-8,0,10" />

                <Button Style="{StaticResource NsPrimaryButton}" Height="64" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="12" Click="NewRecording">
                    <StackPanel>
                        <TextBlock Text="New Screen Recording" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Display, Smart Window Picker, or Area" FontSize="11.5" FontWeight="Normal" Opacity="0.8" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NsOptionButton}" Height="64" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="12" Click="CreateShowcase">
                    <StackPanel>
                        <TextBlock Text="Create Interactive Showcase Project" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="Test 120Hz Auto-Zoom &amp; Multi-Track Blur" FontSize="11.5" Foreground="{ThemeResource Ink60}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NsOptionButton}" Height="44" HorizontalAlignment="Stretch" Click="OpenProject" Content="Open .nativescreen Project…" />
                <Button Style="{StaticResource NsOptionButton}" Height="44" HorizontalAlignment="Stretch" Click="CreateFromVideo" Content="Create Project from Video" />
                <Button Style="{StaticResource NsOptionButton}" Height="44" HorizontalAlignment="Stretch" Click="OpenEmptyEditor" Content="New empty editor" />
                <Button Style="{StaticResource NsOptionButton}" Height="44" HorizontalAlignment="Stretch" Click="OpenSettings" Content="Settings" />
            </StackPanel>

            <Border Grid.Column="1" CornerRadius="16" Padding="20" Background="{ThemeResource SurfacePanel}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Recent Projects (.nativescreen)" FontSize="15" FontWeight="Medium" Foreground="{ThemeResource Ink95}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RecentList" Spacing="8" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
