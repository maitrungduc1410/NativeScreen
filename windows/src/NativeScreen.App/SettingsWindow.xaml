<Window
    x:Class="NativeScreen.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    <Grid x:Name="Root" Background="{ThemeResource SurfacePanel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="DragBar" Padding="16,0" Background="Transparent">
            <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource Ink60}" />
        </Grid>
        <StackPanel x:Name="Tabs" Grid.Row="1" Orientation="Horizontal" Spacing="6" Padding="16,4" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Padding="24,20" Spacing="12" />
        </ScrollViewer>
    </Grid>
</Window>
