<Window
    x:Class="NativeScreen.App.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Native Screen">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="168" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <MenuBar Grid.ColumnSpan="2">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Settings" Click="OpenSettings" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Undo" Click="Undo" />
                <MenuFlyoutItem Text="Redo" Click="Redo" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Command menu" Click="ToggleCommands" />
            </MenuBarItem>
        </MenuBar>
        <CommandBar Grid.Row="1" Grid.ColumnSpan="2" DefaultLabelPosition="Right">
            <AppBarButton x:Name="PlayButton" Label="Play" Click="TogglePlay" />
            <AppBarButton Label="Export" Click="Export" />
        </CommandBar>
        <SwapChainPanel x:Name="Preview" Grid.Row="2" />
        <Grid Grid.Row="2" Grid.Column="1" Padding="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView x:Name="Tabs" SelectionChanged="TabChanged" />
            <TextBlock x:Name="InspectorBody" Grid.Row="1" TextWrapping="Wrap" />
        </Grid>
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Padding="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TimeLabel" Text="0 ms" />
            <Slider x:Name="Playhead" Grid.Row="1" Minimum="0" Maximum="6000" ValueChanged="Scrub" />
            <TextBlock x:Name="TimelineSummary" Grid.Row="2" TextWrapping="Wrap" Opacity="0.75" />
        </Grid>
        <Border x:Name="CommandMenu" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Padding="12" Width="420" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Spacing="8">
                <TextBox x:Name="CommandQuery" PlaceholderText="Command" TextChanged="QueryChanged" />
                <ListView x:Name="CommandList" MaxHeight="240" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
