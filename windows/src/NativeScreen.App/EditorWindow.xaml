<Window
    x:Class="NativeScreen.App.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Native Screen">
    <Grid x:Name="Root" Background="{ThemeResource SurfaceCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="245" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Background="{ThemeResource SurfaceHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" />
            <StackPanel x:Name="TitleLeft" Orientation="Horizontal" Spacing="2" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="MenuButton" Style="{StaticResource NsIconButton}" ToolTipService.ToolTip="Menu">
                    <FontIcon Glyph="&#xE700;" FontSize="15" FontFamily="{StaticResource NsIconFont}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AppMenu" Placement="BottomEdgeAlignedLeft" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="FolderButton" Style="{StaticResource NsIconButton}" Click="ShowInExplorer" ToolTipService.ToolTip="Show project in File Explorer">
                    <FontIcon Glyph="&#xE8B7;" FontSize="16" FontFamily="{StaticResource NsIconFont}" />
                </Button>
                <Button Style="{StaticResource NsIconButton}" IsEnabled="False" ToolTipService.ToolTip="Remove project">
                    <FontIcon Glyph="&#xE74D;" FontSize="15" FontFamily="{StaticResource NsIconFont}" />
                </Button>
            </StackPanel>

            <Grid x:Name="TitleCenter" Grid.Column="1" Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="TitleButton" Style="{StaticResource NsPillButton}" Click="BeginRename" ToolTipService.ToolTip="Rename project">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock x:Name="TitleName" FontSize="13.5" FontWeight="Medium" Foreground="{ThemeResource Ink95}" />
                        <TextBlock Text=".nativescreen" FontSize="13.5" Foreground="{ThemeResource Ink45}" />
                    </StackPanel>
                </Button>
                <TextBox x:Name="TitleEditor" Visibility="Collapsed" MinWidth="220" LostFocus="CommitRename" KeyDown="RenameKeyDown" />
            </Grid>

            <StackPanel x:Name="TitleRight" Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="0,0,152,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource NsIconButton}" Click="ToggleCommands" ToolTipService.ToolTip="Show command menu... (Ctrl+K)">
                    <FontIcon Glyph="&#xE765;" FontSize="16" FontFamily="{StaticResource NsIconFont}" />
                </Button>
                <Border Width="1" Height="18" Background="{ThemeResource Ink14}" />
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="UndoButton" Style="{StaticResource NsIconButton}" Click="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                        <FontIcon Glyph="&#xE7A7;" FontSize="15" FontFamily="{StaticResource NsIconFont}" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource NsIconButton}" Click="Redo" ToolTipService.ToolTip="Redo (Ctrl+Shift+Z)">
                        <FontIcon Glyph="&#xE7A6;" FontSize="15" FontFamily="{StaticResource NsIconFont}" />
                    </Button>
                </StackPanel>
                <Border Width="1" Height="18" Background="{ThemeResource Ink14}" />
                <Button Style="{StaticResource NsPillButton}" Height="36" Padding="12,0" IsEnabled="False" ToolTipService.ToolTip="Not available on Windows yet">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE734;" FontSize="13" FontFamily="{StaticResource NsIconFont}" />
                        <TextBlock Text="Presets" FontSize="13" />
                        <FontIcon Glyph="&#xE70D;" FontSize="9" FontFamily="{StaticResource NsIconFont}" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="18" Background="{ThemeResource Ink14}" />
                <Button Style="{StaticResource NsPrimaryButton}" Click="ShowExport">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE898;" FontSize="13" FontFamily="{StaticResource NsIconFont}" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{ThemeResource Ink07}" />

        <!-- Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="344" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,6" HorizontalAlignment="Center">
                    <Button Style="{StaticResource NsPillButton}" ToolTipService.ToolTip="Output aspect ratio">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE799;" FontSize="13" FontFamily="{StaticResource NsIconFont}" />
                            <TextBlock x:Name="AspectName" Foreground="{ThemeResource Ink95}" />
                            <TextBlock x:Name="AspectRatio" Foreground="{ThemeResource Ink45}" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" FontFamily="{StaticResource NsIconFont}" Foreground="{ThemeResource Ink60}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="AspectMenu" Placement="Bottom" />
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource NsPillButton}" IsEnabled="False" ToolTipService.ToolTip="Not available on Windows yet">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7A8;" FontSize="13" FontFamily="{StaticResource NsIconFont}" />
                            <TextBlock Text="Crop" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NsPillButton}" IsEnabled="False" ToolTipService.ToolTip="Not available on Windows yet">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE722;" FontSize="13" FontFamily="{StaticResource NsIconFont}" />
                            <TextBlock Text="Export frame" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid x:Name="PreviewHost" Grid.Row="1">
                    <Border x:Name="PreviewFrame" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10">
                        <SwapChainPanel x:Name="Preview" />
                    </Border>
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0"
                        Padding="6"
                        CornerRadius="16"
                        Background="{ThemeResource SurfaceDock}"
                        BorderBrush="{ThemeResource Ink10}"
                        BorderThickness="1">
                        <StackPanel x:Name="QuickDock" Spacing="12" />
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="14,8">
                    <Button x:Name="SplitButton" Style="{StaticResource NsIconButton}" Click="ToggleSplit" HorizontalAlignment="Left" ToolTipService.ToolTip="Split clip (C)">
                        <FontIcon x:Name="SplitIcon" Glyph="&#xE8C6;" FontSize="15" FontFamily="{StaticResource NsIconFont}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentTime" Width="64" TextAlignment="Right" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource Ink60}" />
                        <Button Style="{StaticResource NsIconButton}" Click="JumpStart" ToolTipService.ToolTip="Jump to start">
                            <FontIcon Glyph="&#xE892;" FontSize="14" FontFamily="{StaticResource NsIconFont}" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource NsIconButton}" Width="40" Height="40" Click="TogglePlay" ToolTipService.ToolTip="Play (Space)">
                            <Grid Width="27" Height="27">
                                <Ellipse Stroke="{ThemeResource Ink95}" StrokeThickness="1.5" />
                                <FontIcon x:Name="PlayIcon" Glyph="&#xF5B0;" FontSize="11" FontFamily="{StaticResource NsIconFont}" Foreground="{ThemeResource Ink95}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NsIconButton}" Click="JumpEnd" ToolTipService.ToolTip="Jump to end">
                            <FontIcon Glyph="&#xE893;" FontSize="14" FontFamily="{StaticResource NsIconFont}" />
                        </Button>
                        <TextBlock x:Name="TotalTime" Width="64" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource Ink45}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource NsIconButton}" IsEnabled="False" ToolTipService.ToolTip="Playback speed">
                            <TextBlock Text="1x" FontSize="12.5" />
                        </Button>
                        <Slider x:Name="TimelineZoom" Width="96" Minimum="1" Maximum="6" Value="1" StepFrequency="0.05" VerticalAlignment="Center" IsThumbToolTipEnabled="False" ValueChanged="TimelineZoomChanged" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Icon rail -->
            <Border Grid.Column="1" Background="{ThemeResource SurfaceRail}" Padding="6,10">
                <StackPanel x:Name="TabRail" Spacing="4" />
            </Border>

            <!-- Inspector -->
            <Border Grid.Column="2" Background="{ThemeResource SurfaceRail}" Padding="0,8,8,8">
                <Border CornerRadius="16" Background="{ThemeResource SurfacePanel}">
                    <ScrollViewer x:Name="InspectorScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
                        <StackPanel x:Name="InspectorBody" Padding="20" Spacing="22" />
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{ThemeResource Ink07}" />

        <!-- Timeline -->
        <Grid x:Name="TimelineHost" Grid.Row="4" Background="{ThemeResource SurfaceCanvas}" />

        <!-- Command menu -->
        <Grid x:Name="CommandOverlay" Grid.RowSpan="5" Visibility="Collapsed" Background="#66000000" Tapped="CommandOverlayTapped">
            <Border
                x:Name="CommandCard"
                Width="560"
                Margin="0,90,0,0"
                Padding="10"
                VerticalAlignment="Top"
                CornerRadius="14"
                Background="{ThemeResource SurfaceModal}"
                BorderBrush="{ThemeResource Ink14}"
                BorderThickness="1"
                Tapped="SwallowTap">
                <StackPanel Spacing="8">
                    <TextBox x:Name="CommandQuery" PlaceholderText="Type a command" TextChanged="QueryChanged" KeyDown="CommandQueryKeyDown" />
                    <ListView x:Name="CommandList" MaxHeight="340" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="CommandClicked" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Export settings -->
        <Grid x:Name="ExportOverlay" Grid.RowSpan="5" Visibility="Collapsed" Background="#99000000">
            <Border
                Width="620"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="16"
                Background="{ThemeResource SurfaceModal}"
                BorderBrush="{ThemeResource Ink14}"
                BorderThickness="1">
                <StackPanel x:Name="ExportBody" Spacing="18" />
            </Border>
        </Grid>

        <!-- Toast -->
        <Border
            x:Name="Toast"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,18"
            Padding="16,9"
            CornerRadius="10"
            Background="{ThemeResource SurfaceDock}"
            BorderBrush="{ThemeResource Ink14}"
            BorderThickness="1"
            IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="13" />
        </Border>
    </Grid>
</Window>
