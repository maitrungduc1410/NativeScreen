<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NativeScreen.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Program.Main handles the mcp switch before WinUI starts (spec/06 ADR-52). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NsPackage)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <!-- scripts/package-msix.ps1. Self-contained, so a clean machine needs no separate runtime. -->
  <PropertyGroup Condition="'$(NsPackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- One catalog for both apps (spec/06 ADR-44): the macOS file is the source of truth. -->
    <Content Include="..\..\..\macos\NativeScreen\Localizable.xcstrings" Link="Localization\Localizable.xcstrings" CopyToOutputDirectory="PreserveNewest" />
    <!-- One MCP tool list for both apps (spec/06 ADR-52): names, descriptions and schemas are not forked. -->
    <Content Include="..\..\..\macos\NativeScreen\Resources\MCPTools.json" Link="Mcp\MCPTools.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <ProjectReference Include="..\NativeScreen.Core\NativeScreen.Core.csproj" />
    <ProjectReference Include="..\NativeScreen.Media\NativeScreen.Media.csproj" />
    <ProjectReference Include="..\NativeScreen.Rendering\NativeScreen.Rendering.csproj" />
    <ProjectReference Include="..\NativeScreen.Export\NativeScreen.Export.csproj" />
    <ProjectReference Include="..\NativeScreen.Intelligence\NativeScreen.Intelligence.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(NsPackage)' == 'true'">
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\StoreLogo.png;Assets\Square44x44Logo.png;Assets\Square150x150Logo.png" />
  </ItemGroup>
  <!-- Publishing an unpackaged app leaves out its compiled XAML and resource index, and WinUI then fails at startup. -->
  <!-- Debug layers and link libraries of the inference packages, tens of MB that an installed app never loads. -->
  <Target Name="NsTrimInferenceFromPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)DirectML.Debug.dll;$(PublishDir)DirectML.Debug.pdb;$(PublishDir)DirectML.pdb;$(PublishDir)onnxruntime.lib" />
  </Target>
  <Target Name="NsCopyXamlToPublish" AfterTargets="Publish" Condition="'$(NsPackage)' != 'true'">
    <ItemGroup>
      <NsXamlOutput Include="$(OutDir)*.xbf;$(OutDir)NativeScreen.App.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(NsXamlOutput)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
