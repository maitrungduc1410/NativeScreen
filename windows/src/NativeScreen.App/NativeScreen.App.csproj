<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- GraphicsCaptureSession.IsCursorCaptureEnabled needs Windows 10 2004; the Store manifest says the same. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>NativeScreen.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Program.Main handles the mcp switch before WinUI starts (spec/06 ADR-52). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NsPackage)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <!-- scripts/package-msix.ps1. Self-contained, so a clean machine needs no separate runtime. -->
  <PropertyGroup Condition="'$(NsPackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <!-- The Store build has no Velopack and never updates itself (spec/06 ADR-81). -->
    <DefineConstants>$(DefineConstants);NS_STORE</DefineConstants>
    <!-- Partner Center > Product identity. The defaults make a sideloadable test package (docs/releasing.md). -->
    <NsStoreIdentityName Condition="'$(NsStoreIdentityName)' == ''">NativeScreen</NsStoreIdentityName>
    <NsStorePublisher Condition="'$(NsStorePublisher)' == ''">CN=NativeScreen</NsStorePublisher>
    <NsStorePublisherDisplayName Condition="'$(NsStorePublisherDisplayName)' == ''">Native Screen</NsStorePublisherDisplayName>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- One catalog for both apps (spec/06 ADR-44): the macOS file is the source of truth. -->
    <Content Include="..\..\..\macos\NativeScreen\Localizable.xcstrings" Link="Localization\Localizable.xcstrings" CopyToOutputDirectory="PreserveNewest" />
    <!-- One MCP tool list for both apps (spec/06 ADR-52): names, descriptions and schemas are not forked. -->
    <Content Include="..\..\..\macos\NativeScreen\Resources\MCPTools.json" Link="Mcp\MCPTools.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Velopack" Condition="'$(NsPackage)' != 'true'" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <ProjectReference Include="..\NativeScreen.Core\NativeScreen.Core.csproj" />
    <ProjectReference Include="..\NativeScreen.Media\NativeScreen.Media.csproj" />
    <ProjectReference Include="..\NativeScreen.Rendering\NativeScreen.Rendering.csproj" />
    <ProjectReference Include="..\NativeScreen.Export\NativeScreen.Export.csproj" />
    <ProjectReference Include="..\NativeScreen.Intelligence\NativeScreen.Intelligence.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(NsPackage)' == 'true'">
    <!-- A copy with this build's identity and version, written by NsStampStoreManifest. -->
    <AppxManifest Include="$(IntermediateOutputPath)Package.appxmanifest" />
    <!-- Tiles and logos with their scale and target size variants, drawn by scripts/make-store-assets.ps1. -->
    <Content Include="Assets\Store\*.png" />
  </ItemGroup>
  <Target Name="NsStampStoreManifest" BeforeTargets="PrepareForBuild" Condition="'$(NsPackage)' == 'true'">
    <PropertyGroup>
      <!-- The Store needs a zero revision, and the version must rise with every submission. -->
      <NsPackageVersion Condition="'$(NsPackageVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value).0</NsPackageVersion>
      <NsStoreManifest>$(IntermediateOutputPath)Package.appxmanifest</NsStoreManifest>
      <NsManifestNamespaces>&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;</NsManifestNamespaces>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(NsPackageVersion)', '^\d+\.\d+\.\d+\.0$'))" Text="NsPackageVersion must be major.minor.build.0, got '$(NsPackageVersion)'." />
    <Copy SourceFiles="Package.appxmanifest" DestinationFiles="$(NsStoreManifest)" />
    <XmlPoke XmlInputPath="$(NsStoreManifest)" Namespaces="$(NsManifestNamespaces)" Query="/m:Package/m:Identity/@Name" Value="$(NsStoreIdentityName)" />
    <XmlPoke XmlInputPath="$(NsStoreManifest)" Namespaces="$(NsManifestNamespaces)" Query="/m:Package/m:Identity/@Publisher" Value="$(NsStorePublisher)" />
    <XmlPoke XmlInputPath="$(NsStoreManifest)" Namespaces="$(NsManifestNamespaces)" Query="/m:Package/m:Identity/@Version" Value="$(NsPackageVersion)" />
    <XmlPoke XmlInputPath="$(NsStoreManifest)" Namespaces="$(NsManifestNamespaces)" Query="/m:Package/m:Properties/m:PublisherDisplayName" Value="$(NsStorePublisherDisplayName)" />
    <Message Importance="high" Text="Store manifest: $(NsStoreIdentityName), $(NsStorePublisher), $(NsStorePublisherDisplayName), $(NsPackageVersion)" />
  </Target>
  <!-- The Windows App SDK and the inference packages both bring onnxruntime.dll, onnxruntime_providers_shared.dll and DirectML.dll, and a package holds one
       file per path. Keep the copies the unpackaged build ends up with (the Windows App SDK's), so both builds load the
       same native runtime (spec/06 ADR-81). -->
  <Target Name="NsDropDuplicateInferenceDlls" BeforeTargets="_ComputeAppxPackagePayload" Condition="'$(NsPackage)' == 'true'">
    <ItemGroup>
      <NsDuplicateInferenceDll Include="@(PackagingOutputs)" Condition="$([System.String]::Copy('%(PackagingOutputs.FullPath)').ToLowerInvariant().Contains('\microsoft.ml.onnxruntime.directml\')) and ('%(PackagingOutputs.Filename)%(PackagingOutputs.Extension)' == 'onnxruntime.dll' or '%(PackagingOutputs.Filename)%(PackagingOutputs.Extension)' == 'onnxruntime_providers_shared.dll')" />
      <NsDuplicateInferenceDll Include="@(PackagingOutputs)" Condition="$([System.String]::Copy('%(PackagingOutputs.FullPath)').ToLowerInvariant().Contains('\microsoft.ai.directml\')) and '%(PackagingOutputs.Filename)%(PackagingOutputs.Extension)' == 'DirectML.dll'" />
      <PackagingOutputs Remove="@(NsDuplicateInferenceDll)" />
      <!-- Symbols never go in the package; leaving them out also skips the symbol package step. Like the publish trim
           below: the DirectML debug layer, and speech runtimes for other processors (this package is x64). -->
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="'%(PackagingOutputs.Extension)' == '.pdb' or '%(PackagingOutputs.Filename)%(PackagingOutputs.Extension)' == 'DirectML.Debug.dll' or $([System.String]::Copy('%(PackagingOutputs.FullPath)').Contains('\win-arm64\')) or $([System.String]::Copy('%(PackagingOutputs.FullPath)').Contains('\win-x86\'))" />
    </ItemGroup>
  </Target>
  <!-- Windows App SDK 1.8 also lists its copies in the publish files, so the SDK's duplicate check stops the MSIX build
       before packaging. Drop the inference packages' copies there too: DirectML is the same 1.15.4, and the SDK's onnxruntime 1.23 runs the 1.24 API (spec/06 ADR-97). -->
  <Target Name="NsDropDuplicateInferenceDllsFromPublish" AfterTargets="ComputeFilesToPublish" BeforeTargets="_HandleFileConflictsForPublish" Condition="'$(NsPackage)' == 'true'">
    <ItemGroup>
      <NsDuplicatePublishDll Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').ToLowerInvariant().Contains('\microsoft.ml.onnxruntime.directml\')) and ('%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime.dll' or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'onnxruntime_providers_shared.dll')" />
      <NsDuplicatePublishDll Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').ToLowerInvariant().Contains('\microsoft.ai.directml\')) and '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'DirectML.dll'" />
      <ResolvedFileToPublish Remove="@(NsDuplicatePublishDll)" />
    </ItemGroup>
  </Target>
  <!-- Publishing an unpackaged app leaves out its compiled XAML and resource index, and WinUI then fails at startup. -->
  <!-- Debug layers and link libraries of the inference packages, tens of MB that an installed app never loads. -->
  <Target Name="NsTrimInferenceFromPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)DirectML.Debug.dll;$(PublishDir)DirectML.Debug.pdb;$(PublishDir)DirectML.pdb;$(PublishDir)onnxruntime.lib" />
  </Target>
  <Target Name="NsCopyXamlToPublish" AfterTargets="Publish" Condition="'$(NsPackage)' != 'true'">
    <ItemGroup>
      <NsXamlOutput Include="$(OutDir)*.xbf;$(OutDir)NativeScreen.App.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(NsXamlOutput)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
