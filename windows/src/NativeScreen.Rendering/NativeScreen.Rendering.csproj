<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NativeScreen.Rendering</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NativeScreen.Core\NativeScreen.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" />
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Vortice.Direct3D11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.hlsl" />
    <Content Include="..\..\..\conformance\looks\*.cube" Link="Assets\Looks\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\macos\NativeScreen\Resources\Cursors.bundle\sets\**\*.svg" Link="Assets\Cursors\sets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\macos\NativeScreen\Resources\Cursors.bundle\sounds\**\*.wav" Link="Assets\Cursors\sounds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\macos\NativeScreen\Resources\Stickers.bundle\*" Link="Assets\Stickers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\macos\NativeScreen\Resources\CameraBackgrounds.bundle\**\*" Link="Assets\CameraBackgrounds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\macos\NativeScreen\Resources\Wallpapers.bundle\**\*.jpg" Link="Assets\Wallpapers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
