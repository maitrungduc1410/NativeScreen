    "Used by Quick export to clipboard (⌥⌘C), Quick export to file (⌥⌘S), and the Export actions after recording." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng cho Xuất nhanh vào clipboard (⌥⌘C), Xuất nhanh ra file (⌥⌘S) và các thao tác Xuất sau khi quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于“快速导出到剪贴板”(⌥⌘C)、“快速导出到文件”(⌥⌘S) 以及录制后的导出操作。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「クリップボードにクイック書き出し」(⌥⌘C)、「ファイルにクイック書き出し」(⌥⌘S)、収録後の書き出し操作で使用されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für „Schnellexport in die Zwischenablage“ (⌥⌘C), „Schnellexport in Datei“ (⌥⌘S) und die Exportaktionen nach der Aufnahme verwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé par Exportation rapide vers le presse-papiers (⌥⌘C), Exportation rapide vers un fichier (⌥⌘S) et les actions d’exportation après l’enregistrement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo usan Exportación rápida al portapapeles (⌥⌘C), Exportación rápida a archivo (⌥⌘S) y las acciones de exportación después de grabar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado por Exportação rápida para a área de transferência (⌥⌘C), Exportação rápida para arquivo (⌥⌘S) e pelas ações de exportação após a gravação."
          }
        }
