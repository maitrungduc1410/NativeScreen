    "Bright crisp winter daylight with clean icy highlights" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ánh sáng ban ngày mùa đông sáng, trong, vùng sáng lạnh sạch"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明亮清透的冬日日光，干净冰冷的高光"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るく澄んだ冬の日差しとクリアで冷たいハイライト"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helles, klares Winterlicht mit sauberen, eisigen Lichtern"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumière d’hiver vive et nette, hautes lumières glacées et propres"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz de invierno brillante y nítida, con luces limpias y heladas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz de inverno clara e nítida, com realces limpos e gelados"
          }
        }
      }
    },
    "By default, only 2+ keys shortcuts are shown. Enable this option to show single letter shortcuts as well." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định chỉ hiện phím tắt từ 2 phím trở lên. Bật tùy chọn này để hiện cả phím tắt một chữ cái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认只显示 2 个及以上按键的快捷键。启用此选项可同时显示单个字母的快捷键。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは 2 キー以上のショートカットのみ表示されます。このオプションを有効にすると、1 文字のショートカットも表示されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig werden nur Kurzbefehle mit 2 oder mehr Tasten gezeigt. Aktiviere diese Option, um auch Kurzbefehle mit einem Buchstaben zu zeigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, seuls les raccourcis de 2 touches ou plus sont affichés. Activez cette option pour afficher aussi les raccourcis d’une seule lettre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por omisión solo se muestran los atajos de 2 o más teclas. Activa esta opción para mostrar también los de una sola letra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, só atalhos com 2 ou mais teclas são mostrados. Ative esta opção para mostrar também atalhos de uma só letra."
          }
        }
      }
    },
