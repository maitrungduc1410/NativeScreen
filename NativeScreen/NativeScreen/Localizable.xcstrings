    "Edit your video by editing its text: delete words to cut them out, remove filler words and long pauses in one click." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sửa video bằng cách sửa chữ: xóa từ để cắt chúng đi, bỏ từ đệm và khoảng lặng dài chỉ với một cú bấm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过编辑文字来编辑视频：删除字词即可剪掉对应部分，一键移除填充词和长时间停顿。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストを編集してビデオを編集：単語を削除するとその部分がカットされ、フィラーや長い間をワンクリックで取り除けます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite dein Video, indem du den Text bearbeitest: Lösche Wörter, um sie herauszuschneiden, und entferne Füllwörter und lange Pausen mit einem Klick."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montez votre vidéo en modifiant son texte : supprimez des mots pour les couper, retirez les mots de remplissage et les longues pauses en un clic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita tu vídeo editando su texto: borra palabras para cortarlas y quita muletillas y pausas largas con un clic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edite o vídeo editando o texto: apague palavras para cortá-las e remova palavras de preenchimento e pausas longas com um clique."
          }
        }
      }
    },
