    "New projects start with the style of the last project you edited. A preset marked as default is used instead when there is one." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dự án mới bắt đầu với phong cách của dự án bạn sửa gần nhất. Nếu có preset được đặt làm mặc định thì preset đó được dùng thay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新项目将沿用你上次编辑的项目的样式。如果有标记为默认的预设，则改用该预设。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新規プロジェクトは、最後に編集したプロジェクトのスタイルで始まります。デフォルトに設定したプリセットがある場合は、そちらが使われます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Projekte übernehmen den Stil des zuletzt bearbeiteten Projekts. Gibt es ein als Standard markiertes Preset, wird stattdessen dieses verwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux projets reprennent le style du dernier projet modifié. Si un préréglage est défini par défaut, c’est lui qui est utilisé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos nuevos empiezan con el estilo del último proyecto que editaste. Si hay un preajuste marcado por omisión, se usa ese."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos projetos começam com o estilo do último projeto editado. Se houver uma predefinição marcada como padrão, ela é usada no lugar."
          }
        }
      }
    },
