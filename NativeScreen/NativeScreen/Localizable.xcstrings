    "Cursor is hidden in this part of the recording, so you will not see changes you make to it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con trỏ bị ẩn ở đoạn này của bản ghi, nên bạn sẽ không thấy các thay đổi với nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制的这一段隐藏了光标，因此你看不到对它所做的更改。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
