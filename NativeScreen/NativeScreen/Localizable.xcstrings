    "High quality" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chất lượng cao"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高质量"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高画質"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hohe Qualität"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haute qualité"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta calidad"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alta qualidade"
          }
        }
      }
    },
    "Highest quality, best for further editing. Compression is almost impossible to notice." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chất lượng cao nhất, tốt nhất để dựng tiếp. Gần như không nhận ra bị nén."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高质量，最适合后续剪辑。几乎察觉不到压缩。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高画質で、さらに編集するのに最適です。圧縮はほとんど気づきません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchste Qualität, ideal zur Weiterbearbeitung. Die Kompression ist kaum wahrnehmbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualité maximale, idéale pour un montage ultérieur. La compression est presque imperceptible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máxima calidad, ideal para seguir editando. La compresión casi no se nota."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualidade máxima, ideal para continuar editando. A compressão é quase imperceptível."
          }
        }
      }
    },
    "Highest resolution the camera is recorded at, if supported. Higher resolutions look better but use more resources while recording." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ phân giải cao nhất mà camera được ghi, nếu camera hỗ trợ. Độ phân giải càng cao càng đẹp nhưng càng tốn tài nguyên khi quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在支持的情况下摄像头录制的最高分辨率。分辨率越高效果越好，但录制时占用的资源也越多。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応している場合にカメラを収録する最高解像度。解像度が高いほどきれいですが、収録中により多くのリソースを使います。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchste Auflösung, mit der die Kamera aufgenommen wird, sofern unterstützt. Höhere Auflösungen sehen besser aus, brauchen aber während der Aufnahme mehr Ressourcen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résolution la plus élevée à laquelle la caméra est enregistrée, si elle est prise en charge. Plus elle est élevée, plus l’image est belle, mais plus l’enregistrement consomme de ressources."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resolución más alta a la que se graba la cámara, si la admite. Cuanto más alta, mejor se ve, pero más recursos usa durante la grabación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maior resolução em que a câmera é gravada, se houver suporte. Resoluções maiores ficam melhores, mas usam mais recursos durante a gravação."
          }
        }
      }
    },
    "Highlight" : {
      "localizations" : {
