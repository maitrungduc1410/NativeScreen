    "Masks stay locked to the source clip coordinates (even while zooming). Drag or resize directly on the preview." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mask luôn bám theo tọa độ của clip gốc (kể cả khi zoom). Kéo hoặc đổi kích thước trực tiếp trên preview."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遮罩始终锁定在源片段的坐标上（缩放时也是如此）。可直接在预览中拖移或调整大小。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスクは元のクリップの座標に固定されます（ズーム中も同様）。プレビュー上で直接ドラッグやサイズ変更ができます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masken bleiben an den Koordinaten des Quellclips fixiert (auch beim Zoomen). Direkt in der Vorschau ziehen oder die Größe ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les masques restent fixés aux coordonnées du clip source (même pendant un zoom). Faites-les glisser ou redimensionnez-les directement dans l’aperçu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las máscaras se quedan fijas a las coordenadas del clip original (incluso con zoom). Arrástralas o cambia su tamaño directamente en la vista previa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As máscaras ficam presas às coordenadas do clipe de origem (mesmo durante o zoom). Arraste ou redimensione direto na pré-visualização."
          }
        }
      }
    },
