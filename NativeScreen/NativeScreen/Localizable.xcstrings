    "Speech recognition is not allowed. Enable it for Native Screen in System Settings > Privacy & Security > Speech Recognition." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận dạng giọng nói chưa được cho phép. Hãy bật cho Native Screen trong Cài đặt hệ thống > Quyền riêng tư & Bảo mật > Nhận dạng giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不允许语音识别。请在“系统设置”>“隐私与安全性”>“语音识别”中为 Native Screen 开启。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識が許可されていません。「システム設定」>「プライバシーとセキュリティ」>「音声認識」で Native Screen を許可してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spracherkennung ist nicht erlaubt. Aktiviere sie für Native Screen unter „Systemeinstellungen“ > „Datenschutz & Sicherheit“ > „Spracherkennung“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale n’est pas autorisée. Activez-la pour Native Screen dans Réglages Système > Confidentialité et sécurité > Reconnaissance vocale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz no está permitido. Actívalo para Native Screen en Ajustes del Sistema > Privacidad y seguridad > Reconocimiento de voz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reconhecimento de fala não está permitido. Ative-o para o Native Screen em Ajustes do Sistema > Privacidade e Segurança > Reconhecimento de Fala."
          }
        }
      }
    },
