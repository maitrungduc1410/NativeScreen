    "Your changes will be lost if you don’t save them." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thay đổi sẽ mất nếu bạn không lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不存储，你的更改将会丢失。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しないと、変更内容は失われます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderungen gehen verloren, wenn du sie nicht sicherst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications seront perdues si vous ne les enregistrez pas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
