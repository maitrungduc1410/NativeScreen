    "Blurs people's faces shown in the recording, like avatars and video calls" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm mờ khuôn mặt người xuất hiện trong bản ghi, như ảnh đại diện và cuộc gọi video"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊录制中出现的人脸，例如头像和视频通话"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アバターやビデオ通話など、収録に映る人の顔をぼかします"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet Gesichter in der Aufnahme weich, etwa in Avataren und Videoanrufen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floute les visages visibles dans l’enregistrement, comme les avatars et les appels vidéo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoca las caras que aparezcan en la grabación, como avatares y videollamadas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoca rostos que aparecem na gravação, como avatares e chamadas de vídeo"
          }
        }
      }
    },
    "Boosts your voice and reduces background noise and room echo." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăng giọng và giảm tiếng ồn nền cùng tiếng vang phòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提升你的声音，并减少背景噪声和房间回声。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
