    "Better quality to file size ratio than H.264. Not every player can open it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tỉ lệ chất lượng trên dung lượng tốt hơn H.264. Không phải trình phát nào cũng mở được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "质量与文件大小之比优于 H.264。并非所有播放器都能打开。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 より画質とファイルサイズの比率に優れています。すべてのプレーヤーで開けるわけではありません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besseres Verhältnis von Qualität zu Dateigröße als H.264. Nicht jeder Player kann es öffnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleur rapport qualité/taille que le H.264. Tous les lecteurs ne savent pas l’ouvrir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor relación calidad/tamaño que H.264. No todos los reproductores pueden abrirlo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relação qualidade/tamanho melhor que a do H.264. Nem todo player consegue abrir."
          }
        }
      }
    },
