    "Some private details may still be visible in parts of your recording. Watch it in full before you share it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số thông tin riêng tư có thể vẫn hiện ở vài đoạn trong bản ghi. Hãy xem hết trước khi chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制的某些部分可能仍会显示隐私信息。分享前请完整观看一遍。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録の一部に個人情報がまだ映っている可能性があります。共有する前に最後まで確認してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige private Details könnten in Teilen der Aufnahme noch sichtbar sein. Sieh sie dir vollständig an, bevor du sie teilst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines informations privées peuvent encore être visibles dans des parties de votre enregistrement. Regardez-le en entier avant de le partager."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos datos privados pueden seguir viéndose en partes de la grabación. Mírala entera antes de compartirla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dados privados ainda podem aparecer em partes da gravação. Assista inteira antes de compartilhar."
          }
        }
      }
    },
