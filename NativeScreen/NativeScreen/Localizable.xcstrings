    "Great compatibility. Can play literally everywhere. Worse quality to file size ratio than HEVC." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tương thích tốt. Phát được ở mọi nơi. Tỉ lệ chất lượng trên dung lượng kém hơn HEVC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兼容性极佳，几乎在任何地方都能播放。质量与文件大小之比不如 HEVC。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換性が高く、ほぼどこでも再生できます。画質とファイルサイズの比率は HEVC より劣ります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr gute Kompatibilität, läuft praktisch überall. Schlechteres Verhältnis von Qualität zu Dateigröße als HEVC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excellente compatibilité, se lit absolument partout. Rapport qualité/taille moins bon que le HEVC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gran compatibilidad, se reproduce en cualquier sitio. Peor relación calidad/tamaño que HEVC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ótima compatibilidade, reproduz em praticamente qualquer lugar. Relação qualidade/tamanho pior que a do HEVC."
          }
        }
      }
    },
