        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebt deine Stimme an und verringert Hintergrundgeräusche und Raumhall."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monte votre voix et réduit le bruit de fond et l’écho de la pièce."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube tu voz y reduce el ruido de fondo y el eco de la sala."
          }
