    "Gives your voice the depth and clarity of a studio recording. Done locally on device." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho giọng bạn độ dày và rõ như thu trong phòng thu. Xử lý ngay trên máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让你的声音拥有录音棚般的厚度与清晰度。在设备上本地处理。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタジオ収録のような深みと明瞭さを声に与えます。デバイス上で処理されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verleiht deiner Stimme die Tiefe und Klarheit einer Studioaufnahme. Wird lokal auf dem Gerät berechnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne à votre voix la profondeur et la clarté d’un enregistrement en studio. Traité localement sur l’appareil."
          }
        },
        "es" : {
