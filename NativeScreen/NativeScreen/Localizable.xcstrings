    "Points along the direction of travel, like pulled on a leash - and keeps its bearing at rest." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ theo hướng di chuyển như bị kéo bằng dây, và giữ nguyên hướng khi dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像被绳子牵着一样指向移动方向，静止时保持朝向。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひもで引かれるように進行方向を向き、止まってもその向きを保ちます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt in Bewegungsrichtung, wie an einer Leine gezogen, und behält die Richtung im Stillstand."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointe dans le sens du déplacement, comme tiré en laisse, et garde son orientation au repos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta en la dirección del movimiento, como tirado con una correa, y mantiene la orientación en reposo."
