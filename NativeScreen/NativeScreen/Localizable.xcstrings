    "Click 'New Screen Recording' or 'Create Interactive Showcase Project' on the left." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm 'Bản quay màn hình mới' hoặc 'Tạo dự án mẫu tương tác' ở bên trái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按左侧的“新屏幕录制”或“创建交互式示例项目”。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左の「新規画面収録」または「インタラクティブなサンプルプロジェクトを作成」をクリックしてください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke links auf „Neue Bildschirmaufnahme“ oder „Interaktives Beispielprojekt erstellen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur « Nouvel enregistrement d’écran » ou « Créer un projet de démonstration interactif » à gauche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en «Nueva grabación de pantalla» o «Crear proyecto de ejemplo interactivo» a la izquierda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em 'Nova gravação de tela' ou 'Criar projeto de exemplo interativo' à esquerda."
          }
        }
      }
    },
    "Click any word to edit or cut — Cut video removes the spoken segment from the timeline, Cut transcript hides it from captions only." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm vào từ bất kỳ để sửa hoặc cắt — Cắt video bỏ đoạn nói đó khỏi timeline, Cắt transcript chỉ ẩn nó khỏi phụ đề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按任意字词进行编辑或剪切 — “剪切视频”会从时间线中移除这段话，“剪切文字稿”只在字幕中隐藏它。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語をクリックして編集またはカット — 「ビデオをカット」は話した部分をタイムラインから削除し、「文字起こしをカット」は字幕からのみ非表示にします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf ein Wort, um es zu bearbeiten oder zu schneiden — „Video schneiden“ entfernt die gesprochene Stelle aus der Timeline, „Transkript schneiden“ blendet sie nur in den Untertiteln aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un mot pour le modifier ou le couper — Couper la vidéo retire le passage de la timeline, Couper la transcription le masque seulement dans les sous-titres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en cualquier palabra para editarla o cortarla — Cortar vídeo quita ese fragmento de la línea de tiempo, Cortar transcripción solo lo oculta de los subtítulos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em qualquer palavra para editar ou cortar — Cortar vídeo remove o trecho falado da linha do tempo, Cortar transcrição só o oculta das legendas."
          }
        }
      }
    },
