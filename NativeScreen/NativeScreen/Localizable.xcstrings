    "Voiceover plays along with the recording. Voiceover automatically adjusts to the recording speed and is cut out if parts of the recording are cut out." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuyết minh phát cùng bản ghi. Thuyết minh tự khớp tốc độ của bản ghi và bị cắt theo khi các đoạn bản ghi bị cắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旁白随录制一起播放。旁白会自动适应录制速度，剪掉部分录制时也会随之剪掉。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナレーションは収録と一緒に再生されます。収録の速度に自動で合わせ、収録の一部をカットするとナレーションもカットされます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Voiceover wird zusammen mit der Aufnahme abgespielt. Es passt sich der Aufnahmegeschwindigkeit an und wird mitgeschnitten, wenn Teile der Aufnahme herausgeschnitten werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voix off est lue avec l’enregistrement. Elle s’adapte à sa vitesse et est coupée avec les parties de l’enregistrement qui le sont."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz en off se reproduce junto con la grabación. Se adapta automáticamente a su velocidad y se corta cuando se cortan partes de la grabación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A narração toca junto com a gravação. Ela acompanha a velocidade da gravação e é cortada quando partes da gravação são cortadas."
          }
        }
      }
    },
    "Voiceover plays independently of the recording, even if the recording speed is changed or parts of the recording are cut out." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuyết minh phát độc lập với bản ghi, kể cả khi đổi tốc độ bản ghi hay cắt bớt các đoạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旁白独立于录制播放，即使更改录制速度或剪掉部分录制也不受影响。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナレーションは収録とは独立して再生されます。収録の速度を変えたり一部をカットしても影響しません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Voiceover wird unabhängig von der Aufnahme abgespielt, auch wenn die Aufnahmegeschwindigkeit geändert oder Teile herausgeschnitten werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voix off est lue indépendamment de l’enregistrement, même si sa vitesse change ou si des parties sont coupées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voz en off se reproduce de forma independiente de la grabación, aunque cambies su velocidad o cortes partes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A narração toca de forma independente da gravação, mesmo que a velocidade mude ou partes sejam cortadas."
          }
        }
      }
    },
