    "Visually lossless, even for detailed screens and gradients. The usual choice for editing and archiving." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thấy khác biệt bằng mắt, kể cả với màn hình nhiều chi tiết và gradient. Lựa chọn thường dùng để dựng và lưu trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使是细节丰富的屏幕和渐变也视觉无损。剪辑和归档的常用选择。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細かい画面やグラデーションでも視覚的にロスレス。編集やアーカイブで一般的な選択です。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visuell verlustfrei, auch bei detailreichen Bildschirmen und Verläufen. Die übliche Wahl für Schnitt und Archivierung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visuellement sans perte, même pour les écrans détaillés et les dégradés. Le choix courant pour le montage et l’archivage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin pérdida visible, incluso en pantallas detalladas y degradados. La opción habitual para editar y archivar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualmente sem perdas, mesmo em telas detalhadas e gradientes. A escolha usual para edição e arquivamento."
          }
        }
      }
    },
    "Vivid commercial contrast and disciplined color pop" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tương phản rực kiểu quảng cáo, màu nổi có kiểm soát"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
