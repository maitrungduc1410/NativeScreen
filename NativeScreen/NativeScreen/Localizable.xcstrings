    "Save project changes automatically. When off, save with ⌘S; closing a project with unsaved changes asks first." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động lưu thay đổi của dự án. Khi tắt, hãy lưu bằng ⌘S; đóng dự án có thay đổi chưa lưu sẽ được hỏi trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动存储项目更改。关闭时请用 ⌘S 存储；关闭有未存储更改的项目时会先询问。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトの変更を自動で保存します。オフのときは ⌘S で保存します。未保存の変更があるプロジェクトを閉じるときは確認されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektänderungen automatisch sichern. Wenn aus, mit ⌘S sichern; beim Schließen eines Projekts mit ungesicherten Änderungen wird zuerst gefragt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre automatiquement les modifications du projet. Si désactivé, enregistrez avec ⌘S ; la fermeture d’un projet non enregistré demande d’abord confirmation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda automáticamente los cambios del proyecto. Si está desactivado, guarda con ⌘S; al cerrar un proyecto con cambios sin guardar se pregunta antes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva as alterações do projeto automaticamente. Quando desativado, salve com ⌘S; ao fechar um projeto com alterações não salvas, você é avisado antes."
          }
        }
      }
    },
    "Saves both an H.264 and an HEVC file next to each other. Export may be slower, since it has to encode two files at once." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu cả file H.264 và HEVC cạnh nhau. Xuất có thể chậm hơn vì phải mã hóa hai file cùng lúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时存储 H.264 和 HEVC 两个文件。由于要同时编码两个文件，导出可能更慢。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 と HEVC の両方のファイルを並べて保存します。2 つのファイルを同時にエンコードするため、書き出しが遅くなることがあります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert eine H.264- und eine HEVC-Datei nebeneinander. Der Export kann langsamer sein, da zwei Dateien gleichzeitig kodiert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre un fichier H.264 et un fichier HEVC côte à côte. L’exportation peut être plus lente, car deux fichiers sont encodés en même temps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un archivo H.264 y otro HEVC uno al lado del otro. La exportación puede ser más lenta, ya que codifica dos archivos a la vez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva um arquivo H.264 e um HEVC lado a lado. A exportação pode ser mais lenta, pois codifica dois arquivos ao mesmo tempo."
          }
        }
      }
    },
