    "Keep cut words visible as strikethrough so they can be restored." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ các từ đã cắt hiện dạng gạch ngang để có thể khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将剪掉的字词以删除线保留显示，以便恢复。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カットした単語を取り消し線付きで表示し、元に戻せるようにします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschnittene Wörter durchgestrichen anzeigen, damit sie wiederhergestellt werden können."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder les mots coupés visibles en barré pour pouvoir les restaurer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener visibles las palabras cortadas tachadas para poder restaurarlas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém as palavras cortadas visíveis riscadas para poderem ser restauradas."
          }
        }
      }
    },
    "Keep words hidden from captions visible here so they can be restored." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ các từ bị ẩn khỏi phụ đề hiện ở đây để có thể khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从字幕中隐藏的字词保留显示在这里，以便恢复。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕から隠した単語をここに表示し、元に戻せるようにします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus den Untertiteln ausgeblendete Wörter hier anzeigen, damit sie wiederhergestellt werden können."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder ici les mots masqués des sous-titres pour pouvoir les restaurer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener aquí las palabras ocultas de los subtítulos para poder restaurarlas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém aqui as palavras ocultas das legendas para poderem ser restauradas."
          }
        }
      }
    },
    "Keeps more detail and fewer compression artifacts, for a larger file. Turn off for the best balance of file size and quality." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ nhiều chi tiết hơn và ít lỗi nén hơn, đổi lại file lớn hơn. Tắt đi để cân bằng tốt nhất giữa dung lượng và chất lượng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留更多细节、更少压缩瑕疵，但文件更大。关闭可在文件大小与质量之间取得最佳平衡。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細部をより多く残し、圧縮ノイズを減らしますが、ファイルは大きくなります。オフにするとファイルサイズと画質のバランスが最適になります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält mehr Details und weniger Kompressionsartefakte, dafür wird die Datei größer. Ausschalten für die beste Balance aus Dateigröße und Qualität."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve plus de détails et moins d’artefacts de compression, pour un fichier plus lourd. Désactivez pour le meilleur équilibre entre taille et qualité."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva más detalle y menos artefactos de compresión, a cambio de un archivo más grande. Desactívalo para el mejor equilibrio entre tamaño y calidad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém mais detalhes e menos artefatos de compressão, com um arquivo maior. Desative para o melhor equilíbrio entre tamanho e qualidade."
          }
        }
      }
    },
