    "The app stays reachable from the recording bar and the menu bar icon." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng vẫn mở được từ thanh quay và biểu tượng trên thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍可从录制栏和菜单栏图标访问 App。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録バーとメニューバーのアイコンから App にアクセスできます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App bleibt über die Aufnahmeleiste und das Symbol in der Menüleiste erreichbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app reste accessible depuis la barre d’enregistrement et l’icône de la barre des menus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app sigue accesible desde la barra de grabación y el icono de la barra de menús."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app continua acessível pela barra de gravação e pelo ícone da barra de menus."
          }
        }
      }
    },
    "The line box appears at its full size right away." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khung dòng hiện đủ kích thước ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行框立即以完整大小出现。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行のボックスが最初から最大サイズで表示されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeilenkasten erscheint sofort in voller Größe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cadre de la ligne apparaît tout de suite en taille réelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cuadro de la línea aparece de inmediato a tamaño completo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caixa da linha aparece no tamanho total logo de cara."
          }
        }
      }
    },
    "The line box grows from its left edge as words are spoken." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khung dòng giãn ra từ cạnh trái khi các từ được nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行框随着字词说出从左边缘展开。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語が話されるにつれて、行のボックスが左端から伸びます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeilenkasten wächst von seinem linken Rand aus, während Wörter gesprochen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cadre de la ligne s’agrandit depuis son bord gauche au fil des mots prononcés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cuadro de la línea crece desde su borde izquierdo a medida que se dicen las palabras."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caixa da linha cresce a partir da borda esquerda conforme as palavras são faladas."
          }
        }
      }
    },
    "The line box grows while staying centered as words are spoken." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khung dòng giãn ra và giữ ở giữa khi các từ được nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行框随着字词说出保持居中展开。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語が話されるにつれて、行のボックスが中央を保ったまま伸びます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeilenkasten wächst zentriert, während Wörter gesprochen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cadre de la ligne s’agrandit en restant centré au fil des mots prononcés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cuadro de la línea crece centrado a medida que se dicen las palabras."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caixa da linha cresce centralizada conforme as palavras são faladas."
          }
        }
      }
    },
    "The part of the screen that is not being recorded is slightly dimmed." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phần màn hình không được quay sẽ tối đi một chút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未被录制的屏幕部分会略微变暗。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録されていない画面の部分が少し暗くなります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der nicht aufgenommene Teil des Bildschirms wird leicht abgedunkelt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La partie de l’écran qui n’est pas enregistrée est légèrement assombrie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte de la pantalla que no se graba se oscurece ligeramente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parte da tela que não está sendo gravada fica levemente escurecida."
          }
        }
      }
    },
    "The standard for editing. Visually lossless for most recordings." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuẩn để dựng phim. Không thấy khác biệt bằng mắt với hầu hết bản ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪辑的标准格式。对大多数录制而言视觉无损。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集用の標準。ほとんどの収録で視覚的にロスレスです。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standard für den Schnitt. Für die meisten Aufnahmen visuell verlustfrei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La norme pour le montage. Visuellement sans perte pour la plupart des enregistrements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estándar para editar. Sin pérdida visible en la mayoría de las grabaciones."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O padrão para edição. Visualmente sem perdas na maioria das gravações."
          }
        }
