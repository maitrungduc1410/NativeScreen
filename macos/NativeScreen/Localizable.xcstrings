        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, Codex, Cursor und andere MCP-Apps können für dich aufnehmen, bearbeiten, Einstellungen ändern und exportieren. Sie verbinden sich nur auf diesem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, Codex, Cursor y otras apps MCP pueden grabar, editar, cambiar ajustes y exportar por ti. Solo se conectan en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, Codex, Cursor et les autres apps MCP peuvent enregistrer, monter, modifier les réglages et exporter pour vous. Elles se connectent uniquement sur ce Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude、Codex、Cursor などの MCP アプリが、収録、編集、設定の変更、書き出しを代わりに行えます。接続はこの Mac 上に限られます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, Codex, Cursor e outros apps MCP podem gravar, editar, mudar ajustes e exportar por você. Eles se conectam apenas neste Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude, Codex, Cursor và các app MCP khác có thể quay, chỉnh sửa, đổi cài đặt và xuất video giúp bạn. Chúng chỉ kết nối được trên máy Mac này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude、Codex、Cursor 和其他 MCP 应用可以替你录制、编辑、更改设置和导出。它们只能在这台 Mac 上连接。"
          }
        }
      }
    },
