          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение остаётся доступным с панели записи и из значка в строке меню."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
