    "Separating you from the background needs a model, downloaded once from huggingface.co. Your video stays on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب فصلك عن الخلفية نموذجًا يُنزَّل مرة واحدة من huggingface.co. يبقى الفيديو على هذا الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K oddělení vás od pozadí je potřeba model, který se jednou stáhne z huggingface.co. Vaše video zůstane na tomto zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Trennen vom Hintergrund wird ein Modell benötigt, das einmalig von huggingface.co geladen wird. Dein Video bleibt auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para separarte del fondo hace falta un modelo, que se descarga una vez de huggingface.co. Tu video se queda en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vous séparer de l'arrière-plan, un modèle est téléchargé une seule fois depuis huggingface.co. Votre vidéo reste sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separarti dallo sfondo richiede un modello, scaricato una volta da huggingface.co. Il tuo video resta su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景と人物を分離するにはモデルが必要で、huggingface.co から一度だけダウンロードします。ビデオはこのデバイスから送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경에서 사람을 분리하려면 huggingface.co에서 한 번 다운로드하는 모델이 필요합니다. 동영상은 이 기기에 남아 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para separar você do fundo é preciso um modelo, baixado uma vez de huggingface.co. Seu vídeo fica neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы отделить вас от фона, нужна модель, загружаемая один раз с huggingface.co. Ваше видео остаётся на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizi arka plandan ayırmak için huggingface.co'dan bir kez indirilen bir model gerekir. Videonuz bu cihazda kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để tách bạn khỏi nền cần một model, chỉ tải một lần từ huggingface.co. Video của bạn vẫn ở trên máy này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你与背景分离需要一个模型，只需从 huggingface.co 下载一次。你的视频会保留在此设备上。"
          }
        },
        "zh-Hant" : {
