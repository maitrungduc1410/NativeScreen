    "Click 'New Screen Recording' or 'Create Interactive Showcase Project' on the left." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على 'تسجيل شاشة جديد' أو 'إنشاء مشروع عرض تفاعلي' على اليسار."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlevo klikněte na „Nový záznam obrazovky“ nebo „Vytvořit interaktivní ukázkový projekt“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke links auf „Neue Bildschirmaufnahme“ oder „Interaktives Beispielprojekt erstellen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en «Nueva grabación de pantalla» o «Crear proyecto de ejemplo interactivo» a la izquierda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur « Nouvel enregistrement d’écran » ou « Créer un projet de démonstration interactif » à gauche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su 'Nuova registrazione schermo' o 'Crea progetto showcase interattivo' a sinistra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左の「新規画面収録」または「インタラクティブなサンプルプロジェクトを作成」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽에서 '새 화면 녹화' 또는 '인터랙티브 쇼케이스 프로젝트 만들기'를 클릭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em 'Nova gravação de tela' ou 'Criar projeto de exemplo interativo' à esquerda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Новая запись экрана» или «Создать интерактивный демо-проект» слева."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soldaki 'Yeni ekran kaydı' veya 'Etkileşimli tanıtım projesi oluştur' düğmesine tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm 'Bản quay màn hình mới' hoặc 'Tạo dự án mẫu tương tác' ở bên trái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按左侧的“新屏幕录制”或“创建交互式示例项目”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下左側的「新螢幕錄影」或「建立互動式展示專案」。"
          }
        }
      }
    },
    "Click any word to edit or cut. Cut video removes the spoken segment from the timeline, Cut transcript hides it from captions only." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على أي كلمة لتحريرها أو قصها. قص الفيديو يزيل الجزء المنطوق من المخطط الزمني، وقص النص يخفيه من الترجمات فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím na slovo ho upravíte nebo vystřihnete. Vystřihnout video odstraní mluvený úsek z časové osy, Vystřihnout z přepisu ho skryje jen v titulcích."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf ein Wort, um es zu bearbeiten oder zu schneiden. „Video schneiden“ entfernt die gesprochene Stelle aus der Timeline, „Transkript schneiden“ blendet sie nur in den Untertiteln aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en cualquier palabra para editarla o cortarla. Cortar vídeo quita ese fragmento de la línea de tiempo, Cortar transcripción solo lo oculta de los subtítulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un mot pour le modifier ou le couper. Couper la vidéo retire le passage de la timeline, Couper la transcription le masque seulement dans les sous-titres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su una parola per modificarla o tagliarla. Taglia video rimuove il parlato dalla timeline, Taglia trascrizione la nasconde solo dai sottotitoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語をクリックして編集またはカット。「ビデオをカット」は話した部分をタイムラインから削除し、「文字起こしをカット」は字幕からのみ非表示にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어를 클릭해 편집하거나 잘라내세요. 동영상 자르기는 말한 구간을 타임라인에서 지우고, 텍스트에서 자르기는 자막에서만 숨깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em qualquer palavra para editar ou cortar. Cortar vídeo remove o trecho falado da linha do tempo, Cortar transcrição só o oculta das legendas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните по слову, чтобы изменить или вырезать его. «Вырезать видео» убирает фрагмент речи с таймлайна, «Вырезать из текста» скрывает его только в субтитрах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemek veya kesmek için bir kelimeye tıklayın. Videoyu kes, konuşulan bölümü zaman çizelgesinden çıkarır; Metinden kes yalnızca altyazılardan gizler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm vào từ bất kỳ để sửa hoặc cắt. Cắt video bỏ đoạn nói đó khỏi timeline, Cắt transcript chỉ ẩn nó khỏi phụ đề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按任意字词进行编辑或剪切。“剪切视频”会从时间线中移除这段话，“剪切文字稿”只在字幕中隐藏它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下任一字詞來編輯或剪下。「剪掉影片」會從時間軸移除這段話，「從逐字稿剪掉」只會在字幕中隱藏。"
          }
        }
      }
    },
