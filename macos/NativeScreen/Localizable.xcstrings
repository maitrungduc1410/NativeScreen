    "Light, dark, or follow the system setting. Also available in the command menu (⌘K)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فاتح أو داكن أو اتباع إعداد النظام. متاح أيضًا في قائمة الأوامر (⌘K)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Světlý, tmavý nebo podle systému. Dostupné i v nabídce příkazů (⌘K)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hell, dunkel oder wie in den Systemeinstellungen. Auch im Befehlsmenü (⌘K) verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro, oscuro o según el ajuste del sistema. También disponible en el menú de comandos (⌘K)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clair, sombre ou selon le réglage du système. Également disponible dans le menu des commandes (⌘K)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiaro, scuro o segui l'impostazione di sistema. Disponibile anche nel menu comandi (⌘K)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライト、ダーク、またはシステム設定に合わせます。コマンドメニュー (⌘K) からも切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트, 다크 또는 시스템 설정을 따릅니다. 명령 메뉴(⌘K)에서도 바꿀 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro, escuro ou conforme o ajuste do sistema. Também disponível no menu de comandos (⌘K)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Светлое, тёмное или как в системе. Также доступно в меню команд (⌘K)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık, koyu veya sistem ayarını izle. Komut menüsünde de var (⌘K)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sáng, tối, hoặc theo cài đặt hệ thống. Cũng có trong menu lệnh (⌘K)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浅色、深色或跟随系统设置。也可在命令菜单 (⌘K) 中切换。"
