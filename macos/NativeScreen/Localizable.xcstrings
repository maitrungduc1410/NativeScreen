    "Follows what it points at when the video zooms or pans." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع ما يشير إليه عندما يكبّر الفيديو أو يتحرك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje to, na co ukazuje, když video přibližuje nebo posouvá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt dem Ziel, wenn das Video zoomt oder schwenkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue a lo que señala cuando el vídeo hace zoom o se desplaza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit ce qu’elle désigne quand la vidéo zoome ou se déplace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue ciò che indica quando il video fa zoom o si sposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画のズームやパンに合わせて、指している対象を追います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상이 줌하거나 이동할 때 가리키는 대상을 따라갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanha o que aponta quando o vídeo dá zoom ou se move."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следует за объектом, когда видео увеличивается или сдвигается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
