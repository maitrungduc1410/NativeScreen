    "Masks stay locked to the source clip coordinates (even while zooming). Drag or resize directly on the preview." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الأقنعة مثبتة على إحداثيات المقطع المصدر (حتى أثناء التكبير). اسحب أو غيّر الحجم مباشرة في المعاينة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masky zůstávají zamčené na souřadnicích zdrojového klipu (i při přiblížení). Přetahujte a měňte velikost přímo v náhledu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masken bleiben an den Koordinaten des Quellclips fixiert (auch beim Zoomen). Direkt in der Vorschau ziehen oder die Größe ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las máscaras se quedan fijas a las coordenadas del clip original (incluso con zoom). Arrástralas o cambia su tamaño directamente en la vista previa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les masques restent fixés aux coordonnées du clip source (même pendant un zoom). Faites-les glisser ou redimensionnez-les directement dans l’aperçu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le maschere restano agganciate alle coordinate della clip sorgente (anche durante lo zoom). Trascina o ridimensiona direttamente nell'anteprima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスクは元のクリップの座標に固定されます（ズーム中も同様）。プレビュー上で直接ドラッグやサイズ変更ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마스크는 원본 클립 좌표에 고정됩니다(줌 중에도). 미리보기에서 바로 드래그하거나 크기를 조절하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As máscaras ficam presas às coordenadas do clipe de origem (mesmo durante o zoom). Arraste ou redimensione direto na pré-visualização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маски привязаны к координатам исходного клипа (даже при зуме). Перетаскивайте и меняйте размер прямо в превью."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maskeler kaynak klibin koordinatlarına kilitli kalır (yakınlaştırırken bile). Doğrudan önizlemede sürükleyin veya yeniden boyutlandırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mask luôn bám theo tọa độ của clip gốc (kể cả khi zoom). Kéo hoặc đổi kích thước trực tiếp trên preview."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遮罩始终锁定在源片段的坐标上（缩放时也是如此）。可直接在预览中拖移或调整大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遮罩始終鎖定在來源片段的座標上（縮放時也是）。可直接在預覽中拖移或調整大小。"
          }
        }
      }
    },
    "Matches project" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطابق للمشروع"
