    "A file or folder with the same name already exists in the folder %@. Replacing it will overwrite its current contents." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد ملف أو مجلد بالاسم نفسه في المجلد %@. الاستبدال سيكتب فوق محتواه الحالي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve složce %@ už existuje soubor nebo složka se stejným názvem. Nahrazením se přepíše jeho obsah."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Ordner „%@“ gibt es bereits eine Datei oder einen Ordner mit diesem Namen. Beim Ersetzen wird der Inhalt überschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un archivo o carpeta con el mismo nombre en la carpeta %@. Al reemplazarlo se sobrescribirá su contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier ou dossier du même nom existe déjà dans le dossier %@. Le remplacer écrasera son contenu actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella cartella %@ esiste già un file o una cartella con lo stesso nome. Sostituendolo, il contenuto attuale verrà sovrascritto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ名前のファイルまたはフォルダが「%@」フォルダにすでにあります。置き換えると現在の内容は上書きされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 이름의 파일이나 폴더가 %@ 폴더에 이미 있습니다. 대치하면 현재 내용을 덮어씁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe um arquivo ou pasta com o mesmo nome na pasta %@. Substituir vai sobrescrever o conteúdo atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В папке «%@» уже есть файл или папка с таким именем. При замене текущее содержимое будет перезаписано."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ klasöründe aynı adlı bir dosya veya klasör zaten var. Değiştirmek mevcut içeriğin üzerine yazar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong thư mục %@ đã có tệp hoặc thư mục cùng tên. Thay thế sẽ ghi đè nội dung hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件夹“%@”中已有同名的文件或文件夹。替换将覆盖其当前内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料夾「%@」中已有同名的檔案或資料夾。取代將覆寫其目前內容。"
          }
        }
      }
    },
    "A file or folder with the same name already exists on the Desktop. Replacing it will overwrite its current contents." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
