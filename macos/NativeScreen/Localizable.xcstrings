    "GIF files are much larger than MP4 files. Use MP4 when you can." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات GIF أكبر بكثير من ملفات MP4. استخدم MP4 متى استطعت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubory GIF jsou mnohem větší než MP4. Pokud můžete, použijte MP4."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIF-Dateien sind viel größer als MP4-Dateien. Verwende MP4, wenn möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos GIF son mucho más grandes que los MP4. Usa MP4 siempre que puedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers GIF sont bien plus lourds que les MP4. Utilisez le MP4 quand c’est possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file GIF sono molto più grandi degli MP4. Usa MP4 quando puoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIF ファイルは MP4 よりずっと大きくなります。できるだけ MP4 を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIF 파일은 MP4 파일보다 훨씬 큽니다. 가능하면 MP4를 쓰세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos GIF são muito maiores que MP4. Use MP4 sempre que puder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы GIF гораздо больше MP4. По возможности используйте MP4."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIF dosyaları MP4 dosyalarından çok daha büyüktür. Mümkünse MP4 kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File GIF lớn hơn MP4 nhiều. Hãy dùng MP4 khi có thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIF 文件比 MP4 大得多。能用 MP4 时请用 MP4。"
