    "Visually lossless, even for detailed screens and gradients. The usual choice for editing and archiving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا فقد مرئي حتى للشاشات المفصّلة والتدرجات. الخيار المعتاد للمونتاج والأرشفة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vizuálně bezeztrátový i pro detailní obrazovky a přechody. Obvyklá volba pro střih a archivaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visuell verlustfrei, auch bei detailreichen Bildschirmen und Verläufen. Die übliche Wahl für Schnitt und Archivierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin pérdida visible, incluso en pantallas detalladas y degradados. La opción habitual para editar y archivar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visuellement sans perte, même pour les écrans détaillés et les dégradés. Le choix courant pour le montage et l’archivage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visivamente senza perdite, anche per schermi dettagliati e sfumature. La scelta abituale per montaggio e archiviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細かい画面やグラデーションでも視覚的にロスレス。編集やアーカイブで一般的な選択です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디테일이 많은 화면과 그라데이션에서도 시각적으로 무손실입니다. 편집과 보관에 흔히 쓰는 선택입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualmente sem perdas, mesmo em telas detalhadas e gradientes. A escolha usual para edição e arquivamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визуально без потерь даже для детальных экранов и градиентов. Обычный выбор для монтажа и архива."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıntılı ekranlar ve gradyanlar için bile görsel olarak kayıpsız. Düzenleme ve arşiv için olağan seçim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thấy khác biệt bằng mắt, kể cả với màn hình nhiều chi tiết và gradient. Lựa chọn thường dùng để dựng và lưu trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使是细节丰富的屏幕和渐变也视觉无损。剪辑和归档的常用选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使是細節豐富的螢幕和漸層也視覺無損。剪輯和封存的常用選擇。"
          }
        }
      }
    },
