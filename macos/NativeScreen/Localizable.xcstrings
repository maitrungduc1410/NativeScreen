    "Captions are off. Right-click a caption on the timeline to turn them back on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمات متوقفة. انقر بزر الماوس الأيمن على ترجمة في المخطط الزمني لإعادة تشغيلها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titulky jsou vypnuté. Zapnete je kliknutím pravým tlačítkem na titulek na časové ose."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel sind aus. Klicke mit der rechten Maustaste auf einen Untertitel in der Timeline, um sie wieder einzuschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos están desactivados. Haz clic derecho en un subtítulo de la línea de tiempo para volver a activarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres sont désactivés. Faites un clic droit sur un sous-titre dans la timeline pour les réactiver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottotitoli sono disattivati. Fai clic destro su un sottotitolo nella timeline per riattivarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕はオフです。タイムラインの字幕を右クリックすると、もう一度オンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자막이 꺼져 있습니다. 다시 켜려면 타임라인의 자막을 오른쪽 클릭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As legendas estão desativadas. Clique com o botão direito em uma legenda na linha do tempo para ativá-las de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Субтитры выключены. Щёлкните правой кнопкой по субтитру на таймлайне, чтобы включить их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazılar kapalı. Yeniden açmak için zaman çizelgesinde bir altyazıya sağ tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ đề đang tắt. Chuột phải vào một phụ đề trên timeline để bật lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕已关闭。在时间线上右键点按某条字幕即可重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕已關閉。在時間軸上按右鍵點一下某條字幕即可重新開啟。"
          }
        }
      }
    },
