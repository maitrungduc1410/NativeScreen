    "No favorites yet. Right-click a background and choose “Add to Favorites”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Favoriten. Klicke mit der rechten Maustaste auf einen Hintergrund und wähle „Zu Favoriten hinzufügen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay favoritos. Haz clic derecho en un fondo y elige «Añadir a favoritos»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun favori pour l’instant. Faites un clic droit sur un arrière-plan et choisissez « Ajouter aux favoris »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りはまだありません。背景を右クリックして「お気に入りに追加」を選んでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há favoritos. Clique com o botão direito em um fundo e escolha “Adicionar aos favoritos”."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có mục yêu thích. Nhấp chuột phải vào một hình nền và chọn “Thêm vào mục yêu thích”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
