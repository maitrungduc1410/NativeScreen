    "Gives your voice the depth and clarity of a studio recording. Done locally on device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنح صوتك عمق ووضوح تسجيل الاستوديو. يُعالج محليًا على الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodá hlasu hloubku a jasnost studiové nahrávky. Zpracováno místně na zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verleiht deiner Stimme die Tiefe und Klarheit einer Studioaufnahme. Wird lokal auf dem Gerät berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da a tu voz la profundidad y la claridad de una grabación de estudio. Se procesa en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne à votre voix la profondeur et la clarté d’un enregistrement en studio. Traité localement sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dà alla voce la profondità e la chiarezza di una registrazione in studio. Elaborato localmente sul dispositivo."
          }
