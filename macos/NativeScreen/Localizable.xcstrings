    "Blurs people's faces shown in the recording, like avatars and video calls" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يموّه وجوه الأشخاص الظاهرة في التسجيل، مثل الصور الرمزية ومكالمات الفيديو"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmaže obličeje lidí v záznamu, například avatary a videohovory"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet Gesichter in der Aufnahme weich, etwa in Avataren und Videoanrufen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoca las caras que aparezcan en la grabación, como avatares y videollamadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floute les visages visibles dans l’enregistrement, comme les avatars et les appels vidéo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoca i volti delle persone nella registrazione, come avatar e videochiamate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アバターやビデオ通話など、収録に映る人の顔をぼかします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아바타, 화상 통화 등 녹화에 보이는 사람의 얼굴을 흐리게 합니다"
          }
        },
        "pt-BR" : {
