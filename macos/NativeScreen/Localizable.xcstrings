    "Sun-bleached nostalgia with lifted blacks and softened highlights" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حنين باهت بفعل الشمس مع أسود مرفوع وإضاءات ناعمة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluncem vybledlá nostalgie se zvednutými černými a změkčenými světly"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnengebleichte Nostalgie mit angehobenem Schwarz und weichen Lichtern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia desteñida por el sol, con negros levantados y luces suaves"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgie délavée par le soleil, noirs relevés et hautes lumières adoucies"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia sbiadita dal sole con neri sollevati e alte luci ammorbidite"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持ち上げた黒と柔らかなハイライトの日焼けしたノスタルジー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "살짝 들뜬 블랙과 부드러운 하이라이트의 햇빛에 바랜 향수"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostalgia desbotada pelo sol, com pretos levantados e realces suaves"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выгоревшая на солнце ностальгия с приподнятыми чёрными и мягкими бликами"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükseltilmiş siyahlar ve yumuşatılmış parlaklıklarla güneşte solmuş nostalji"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoài niệm bạc nắng với vùng đen nâng lên và vùng sáng dịu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阳光褪色的怀旧感，提亮的黑位与柔化的高光"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "陽光褪色的懷舊感，提亮的黑位與柔化的高光"
          }
        }
      }
    },
