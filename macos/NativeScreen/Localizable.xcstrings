    "Cursor is hidden in this part of the recording, so you will not see changes you make to it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المؤشر مخفي في هذا الجزء من التسجيل، لذا لن ترى التغييرات التي تجريها عليه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzor je v této části záznamu skrytý, takže změny neuvidíte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Teil der Aufnahme ist der Cursor ausgeblendet, daher siehst du Änderungen daran nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cursor está oculto en esta parte de la grabación, así que no verás los cambios que le hagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le curseur est masqué dans cette partie de l’enregistrement, vous ne verrez donc pas les modifications que vous lui apportez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cursore è nascosto in questa parte della registrazione, quindi non vedrai le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録のこの部分ではカーソルが非表示のため、カーソルへの変更は表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화의 이 부분에서는 커서가 숨겨져 있어 변경 사항이 보이지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cursor está oculto nesta parte da gravação, então você não verá as alterações feitas nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой части записи курсор скрыт, поэтому изменения не будут видны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydın bu bölümünde imleç gizli, bu yüzden yaptığınız değişiklikleri görmeyeceksiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con trỏ bị ẩn ở đoạn này của bản ghi, nên bạn sẽ không thấy các thay đổi với nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
