          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경을 제거하는 모든 곳에 사용됩니다: 컷아웃, 흐리게 하거나 바꾼 배경."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado sempre que o fundo é removido: o recorte e um fundo desfocado ou substituído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
