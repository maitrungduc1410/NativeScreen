    "Boosts your voice and reduces background noise and room echo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوّي صوتك ويقلل ضوضاء الخلفية وصدى الغرفة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zesílí hlas a omezí šum na pozadí a ozvěnu místnosti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebt deine Stimme an und verringert Hintergrundgeräusche und Raumhall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube tu voz y reduce el ruido de fondo y el eco de la sala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monte votre voix et réduit le bruit de fond et l’écho de la pièce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potenzia la voce e riduce il rumore di fondo e l'eco della stanza."
