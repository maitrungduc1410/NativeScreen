    "Keeps more detail and fewer compression artifacts, for a larger file. Turn off for the best balance of file size and quality." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ بتفاصيل أكثر وتشوهات ضغط أقل مقابل ملف أكبر. أوقفه لأفضل توازن بين الحجم والجودة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachová víc detailů a méně artefaktů komprese za cenu většího souboru. Vypněte pro nejlepší poměr velikosti a kvality."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält mehr Details und weniger Kompressionsartefakte, dafür wird die Datei größer. Ausschalten für die beste Balance aus Dateigröße und Qualität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva más detalle y menos artefactos de compresión, a cambio de un archivo más grande. Desactívalo para el mejor equilibrio entre tamaño y calidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve plus de détails et moins d’artefacts de compression, pour un fichier plus lourd. Désactivez pour le meilleur équilibre entre taille et qualité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva più dettagli e meno artefatti di compressione, con un file più grande. Disattiva per il miglior equilibrio tra dimensione e qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "細部をより多く残し、圧縮ノイズを減らしますが、ファイルは大きくなります。オフにするとファイルサイズと画質のバランスが最適になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 커지는 대신 디테일이 더 살고 압축 결함이 줄어듭니다. 파일 크기와 화질의 균형을 원하면 끄세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém mais detalhes e menos artefatos de compressão, com um arquivo maior. Desative para o melhor equilíbrio entre tamanho e qualidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше деталей и меньше артефактов сжатия ценой большего файла. Выключите для лучшего баланса размера и качества."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha büyük dosya karşılığında daha çok ayrıntı ve daha az sıkıştırma bozulması. Dosya boyutu ve kalite dengesi için kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ nhiều chi tiết hơn và ít lỗi nén hơn, đổi lại file lớn hơn. Tắt đi để cân bằng tốt nhất giữa dung lượng và chất lượng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留更多细节、更少压缩瑕疵，但文件更大。关闭可在文件大小与质量之间取得最佳平衡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留更多細節、更少壓縮瑕疵，但檔案更大。關閉可在檔案大小與品質之間取得最佳平衡。"
          }
        }
      }
    },
