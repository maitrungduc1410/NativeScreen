    "For split screen layout, when padding is 0, the camera border radius will only be applied during zoom." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في تخطيط الشاشة المقسومة، عندما يكون الهامش 0، يُطبَّق نصف قطر حافة الكاميرا أثناء التكبير فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U rozložení rozdělené obrazovky s nulovým okrajem se zaoblení okraje kamery použije jen při přiblížení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Split-Screen-Layout wird der Eckenradius der Kamera bei einem Abstand von 0 nur während des Zooms angewendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el diseño de pantalla dividida, con relleno 0, el redondeo de la cámara solo se aplica durante el zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour la disposition en écran partagé, lorsque la marge est à 0, l’arrondi des coins de la caméra ne s’applique que pendant le zoom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel layout a schermo diviso, con margine 0, il raggio del bordo della fotocamera si applica solo durante lo zoom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割画面レイアウトでは、パディングが 0 のとき、カメラの角丸はズーム中のみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할 화면 레이아웃에서 여백이 0이면 카메라 테두리 반경은 줌 중에만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No layout de tela dividida, com espaçamento 0, o arredondamento da câmera só é aplicado durante o zoom."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В макете «разделённый экран» при нулевом отступе скругление рамки камеры применяется только во время зума."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölünmüş ekran yerleşiminde boşluk 0 iken kamera kenar yarıçapı yalnızca yakınlaştırma sırasında uygulanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với bố cục chia đôi màn hình, khi padding bằng 0, bo góc camera chỉ được áp dụng lúc zoom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于分屏布局，当内边距为 0 时，摄像头圆角只在缩放时应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在分割畫面佈局中，內距為 0 時，相機圓角只會在縮放時套用。"
          }
        }
      }
    },
