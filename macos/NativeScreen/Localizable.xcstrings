    "Analyze clicks and typing during the recording and add zooms to every new project." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحليل النقرات والكتابة أثناء التسجيل وإضافة تكبيرات إلى كل مشروع جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
