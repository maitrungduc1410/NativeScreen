    "Settings return to their defaults. Your projects and presets are not deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود الإعدادات إلى قيمها الافتراضية. لا تُحذف مشاريعك وإعداداتك المسبقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení se vrátí na výchozí hodnoty. Projekty a předvolby se nesmažou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen werden auf die Standardwerte zurückgesetzt. Deine Projekte und Presets werden nicht gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes vuelven a sus valores por omisión. Tus proyectos y preajustes no se eliminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages reviennent à leurs valeurs par défaut. Vos projets et préréglages ne sont pas supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni tornano ai valori predefiniti. Progetti e preset non vengono eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定がデフォルトに戻ります。プロジェクトとプリセットは削除されません。"
