    "Great compatibility. Can play literally everywhere. Worse quality to file size ratio than HEVC." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توافق ممتاز. يعمل حرفيًا في كل مكان. نسبة جودة إلى حجم ملف أسوأ من HEVC."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výborná kompatibilita. Přehraje se doslova všude. Horší poměr kvality a velikosti než HEVC."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr gute Kompatibilität, läuft praktisch überall. Schlechteres Verhältnis von Qualität zu Dateigröße als HEVC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gran compatibilidad, se reproduce en cualquier sitio. Peor relación calidad/tamaño que HEVC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excellente compatibilité, se lit absolument partout. Rapport qualité/taille moins bon que le HEVC."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottima compatibilità. Si riproduce davvero ovunque. Rapporto qualità/dimensione peggiore di HEVC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換性が高く、ほぼどこでも再生できます。画質とファイルサイズの比率は HEVC より劣ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호환성이 뛰어납니다. 말 그대로 어디서나 재생됩니다. HEVC보다 화질 대비 파일 크기 비율이 나쁩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ótima compatibilidade, reproduz em praticamente qualquer lugar. Relação qualidade/tamanho pior que a do HEVC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отличная совместимость. Воспроизводится буквально везде. Соотношение качества и размера хуже, чем у HEVC."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harika uyumluluk. Gerçekten her yerde oynar. HEVC'den daha kötü kalite/dosya boyutu oranı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tương thích tốt. Phát được ở mọi nơi. Tỉ lệ chất lượng trên dung lượng kém hơn HEVC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兼容性极佳，几乎在任何地方都能播放。质量与文件大小之比不如 HEVC。"
