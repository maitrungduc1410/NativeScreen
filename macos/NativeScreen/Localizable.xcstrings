            "value" : "ظلال تغوص في الأزرق المخضر بينما تبقى البشرة دافئة وغنية"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stíny se noří do tyrkysové, zatímco pleť zůstává teplá a plná"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schatten tauchen in Petrol ab, die Haut bleibt warm und satt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sombras se hunden en verde azulado mientras la piel sigue cálida y plena"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ombres plongent dans le bleu canard, la peau reste chaude et pleine"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombre che virano al verde acqua mentre la pelle resta calda e piena"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シャドウはティールに沈み、肌は暖かく豊かなまま"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피부는 따뜻하고 풍부하게, 그림자는 청록색으로"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sombras mergulham no azul-petróleo enquanto a pele fica quente e cheia"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тени уходят в бирюзу, а кожа остаётся тёплой и насыщенной"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten sıcak ve dolgun kalırken gölgeler camgöbeğine dalar"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng tối chìm vào xanh mòng két, da vẫn ấm và đầy đặn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
