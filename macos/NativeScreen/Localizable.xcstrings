    "Captions are off. Right-click a caption on the timeline to turn them back on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel sind aus. Klicke mit der rechten Maustaste auf einen Untertitel in der Timeline, um sie wieder einzuschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos están desactivados. Haz clic derecho en un subtítulo de la línea de tiempo para volver a activarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
