    "The app stays reachable from the recording bar and the menu bar icon." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى التطبيق متاحًا من شريط التسجيل وأيقونة شريط القوائم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace zůstane dostupná z panelu nahrávání a z ikony v řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App bleibt über die Aufnahmeleiste und das Symbol in der Menüleiste erreichbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app sigue accesible desde la barra de grabación y el icono de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app reste accessible depuis la barre d’enregistrement et l’icône de la barre des menus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app resta raggiungibile dalla barra di registrazione e dall'icona nella barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録バーとメニューバーのアイコンから App にアクセスできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화 막대와 메뉴 막대 아이콘에서 앱을 계속 쓸 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
