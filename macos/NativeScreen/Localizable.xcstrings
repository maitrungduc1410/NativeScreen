          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportovaný GIF se přehraje jen jednou a zastaví se."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das exportierte GIF wird nur einmal abgespielt und stoppt dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El GIF exportado se reproducirá una sola vez y se detendrá."
          }
        },
        "fr" : {
          "stringUnit" : {
