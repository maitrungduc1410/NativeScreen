    "Points along the direction of travel, like pulled on a leash - and keeps its bearing at rest." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشير باتجاه الحركة كأنه مشدود بمقود، ويحافظ على اتجاهه عند التوقف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Míří ve směru pohybu jako na vodítku a v klidu si drží směr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt in Bewegungsrichtung, wie an einer Leine gezogen, und behält die Richtung im Stillstand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta en la dirección del movimiento, como tirado con una correa, y mantiene la orientación en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointe dans le sens du déplacement, comme tiré en laisse, et garde son orientation au repos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punta nella direzione del movimento, come tirato al guinzaglio, e mantiene la direzione a riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひもで引かれるように進行方向を向き、止まってもその向きを保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목줄에 끌리듯 움직이는 방향을 가리키고, 멈춰도 방향을 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponta na direção do movimento, como puxado por uma guia, e mantém a direção em repouso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указывает по направлению движения, как на поводке, и сохраняет направление в покое."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasmayla çekiliyormuş gibi hareket yönünü gösterir ve dururken yönünü korur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ theo hướng di chuyển như bị kéo bằng dây, và giữ nguyên hướng khi dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像被绳子牵着一样指向移动方向，静止时保持朝向。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像被牽繩拉著一樣指向移動方向，靜止時保持朝向。"
          }
        }
      }
    },
