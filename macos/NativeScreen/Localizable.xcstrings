    "With small cursor size, consider disabling mouse cursor motion blur as it might reduce cursor visibility" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع مؤشر صغير الحجم، فكّر في إيقاف ضبابية حركة المؤشر لأنها قد تقلل وضوحه"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při malém kurzoru zvažte vypnutí rozmazání kurzoru pohybem, protože může zhoršit jeho viditelnost"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei kleiner Cursorgröße solltest du die Bewegungsunschärfe des Mauszeigers ausschalten, da sie die Sichtbarkeit des Cursors verringern kann"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un cursor pequeño, plantéate desactivar el desenfoque de movimiento del cursor, ya que puede hacerlo menos visible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un petit curseur, pensez à désactiver le flou de mouvement du curseur, car il peut le rendre moins visible"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un cursore piccolo, valuta di disattivare l'effetto mosso del cursore, perché può ridurne la visibilità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソルサイズが小さい場合は、カーソルが見えにくくなることがあるため、カーソルのモーションブラーをオフにすることを検討してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서 크기가 작으면 커서가 잘 안 보일 수 있으니 커서 모션 블러를 끄는 것을 고려하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o cursor pequeno, considere desativar o desfoque de movimento do cursor, pois ele pode reduzir a visibilidade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При маленьком курсоре стоит отключить его размытие в движении, иначе он может быть хуже виден"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç küçükken, görünürlüğü azaltabileceği için imleç hareket bulanıklığını kapatmayı düşünün"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với con trỏ nhỏ, nên tắt hiệu ứng nhòe chuyển động của con trỏ vì nó có thể làm con trỏ khó thấy hơn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标较小时，建议关闭光标动态模糊，因为它可能降低光标的可见度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游標較小時，建議關閉游標動態模糊，因為它可能降低游標的可見度"
          }
        }
      }
    },
