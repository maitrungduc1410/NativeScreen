          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta sua voz para um volume constante. O timbre continua o mesmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выравнивает громкость голоса. Его характер не меняется."
