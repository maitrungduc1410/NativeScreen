    "A profile keeps the capture mode, camera, microphone, system audio and recording options, so you can switch setups in one click." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ ملف التعريف وضع الالتقاط والكاميرا والميكروفون وصوت النظام وخيارات التسجيل، لتنتقل بين الإعدادات بنقرة واحدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil uchovává režim snímání, kameru, mikrofon, systémový zvuk a volby nahrávání, takže nastavení přepnete jedním kliknutím."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Profil merkt sich Aufnahmemodus, Kamera, Mikrofon, Systemton und Aufnahmeoptionen, damit du mit einem Klick wechseln kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un perfil guarda el modo de captura, la cámara, el micrófono, el audio del sistema y las opciones de grabación, para cambiar de configuración con un clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profil garde le mode de capture, la caméra, le micro, le son du système et les options d’enregistrement, pour changer de réglages en un clic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profilo conserva modalità di cattura, fotocamera, microfono, audio di sistema e opzioni di registrazione, così cambi configurazione con un clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルには取り込みモード、カメラ、マイク、システムオーディオ、録画オプションが保存され、ワンクリックで切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필은 캡처 모드, 카메라, 마이크, 시스템 오디오, 녹화 옵션을 저장해 한 번의 클릭으로 설정을 전환할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um perfil guarda o modo de captura, a câmera, o microfone, o áudio do sistema e as opções de gravação, para trocar de configuração com um clique."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль хранит режим захвата, камеру, микрофон, системный звук и параметры записи, чтобы переключать настройки одним щелчком."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil; yakalama modunu, kamerayı, mikrofonu, sistem sesini ve kayıt seçeneklerini saklar, böylece kurulumlar arasında tek tıkla geçersiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile lưu chế độ ghi, camera, micro, âm thanh hệ thống và các tùy chọn ghi, để bạn đổi thiết lập chỉ với một cú nhấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置文件会保存捕获模式、摄像头、麦克风、系统音频和录制选项，一键即可切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定檔會儲存擷取模式、相機、麥克風、系統音訊和錄製選項，一鍵即可切換。"
          }
        }
      }
    },
