    "Speech recognition is not allowed. Enable it for Native Screen in System Settings > Privacy & Security > Speech Recognition." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعرف على الكلام غير مسموح. فعّله لـ Native Screen في إعدادات النظام > الخصوصية والأمن > التعرف على الكلام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznávání řeči není povoleno. Povolte ho pro Native Screen v Nastavení systému > Soukromí a zabezpečení > Rozpoznávání řeči."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spracherkennung ist nicht erlaubt. Aktiviere sie für Native Screen unter „Systemeinstellungen“ > „Datenschutz & Sicherheit“ > „Spracherkennung“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de voz no está permitido. Actívalo para Native Screen en Ajustes del Sistema > Privacidad y seguridad > Reconocimiento de voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale n’est pas autorisée. Activez-la pour Native Screen dans Réglages Système > Confidentialité et sécurité > Reconnaissance vocale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale non è consentito. Attivalo per Native Screen in Impostazioni di Sistema > Privacy e sicurezza > Riconoscimento vocale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識が許可されていません。「システム設定」>「プライバシーとセキュリティ」>「音声認識」で Native Screen を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 인식이 허용되지 않았습니다. 시스템 설정 > 개인정보 보호 및 보안 > 음성 인식에서 Native Screen을 허용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reconhecimento de fala não está permitido. Ative-o para o Native Screen em Ajustes do Sistema > Privacidade e Segurança > Reconhecimento de Fala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи запрещено. Разрешите его для Native Screen в Системных настройках > Конфиденциальность и безопасность > Распознавание речи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşma tanımaya izin verilmiyor. Sistem Ayarları > Gizlilik ve Güvenlik > Konuşma Tanıma'dan Native Screen için açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận dạng giọng nói chưa được cho phép. Hãy bật cho Native Screen trong Cài đặt hệ thống > Quyền riêng tư & Bảo mật > Nhận dạng giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不允许语音识别。请在“系统设置”>“隐私与安全性”>“语音识别”中为 Native Screen 开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不允許語音辨識。請在「系統設定」>「隱私權與安全性」>「語音辨識」中為 Native Screen 開啟。"
          }
        }
      }
