    "Used by Quick export to clipboard (⌥⌘C), Quick export to file (⌥⌘S), and the Export actions after recording." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم في التصدير السريع إلى الحافظة (⌥⌘C) والتصدير السريع إلى ملف (⌥⌘S) وإجراءات التصدير بعد التسجيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá rychlý export do schránky (⌥⌘C), rychlý export do souboru (⌥⌘S) a akce exportu po nahrávání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für „Schnellexport in die Zwischenablage“ (⌥⌘C), „Schnellexport in Datei“ (⌥⌘S) und die Exportaktionen nach der Aufnahme verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo usan Exportación rápida al portapapeles (⌥⌘C), Exportación rápida a archivo (⌥⌘S) y las acciones de exportación después de grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé par Exportation rapide vers le presse-papiers (⌥⌘C), Exportation rapide vers un fichier (⌥⌘S) et les actions d’exportation après l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato da Esportazione rapida negli appunti (⌥⌘C), Esportazione rapida su file (⌥⌘S) e dalle azioni di esportazione dopo la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「クリップボードにクイック書き出し」(⌥⌘C)、「ファイルにクイック書き出し」(⌥⌘S)、収録後の書き出し操作で使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드로 빠른 내보내기(⌥⌘C), 파일로 빠른 내보내기(⌥⌘S), 녹화 후 내보내기 동작에 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado por Exportação rápida para a área de transferência (⌥⌘C), Exportação rápida para arquivo (⌥⌘S) e pelas ações de exportação após a gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для быстрого экспорта в буфер обмена (⌥⌘C), быстрого экспорта в файл (⌥⌘S) и действий экспорта после записи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panoya hızlı dışa aktarma (⌥⌘C), dosyaya hızlı dışa aktarma (⌥⌘S) ve kayıttan sonraki dışa aktarma işlemleri tarafından kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng cho Xuất nhanh vào clipboard (⌥⌘C), Xuất nhanh ra file (⌥⌘S) và các thao tác Xuất sau khi quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于“快速导出到剪贴板”(⌥⌘C)、“快速导出到文件”(⌥⌘S) 以及录制后的导出操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於「快速輸出到剪貼簿」(⌥⌘C)、「快速輸出到檔案」(⌥⌘S) 以及錄製後的輸出動作。"
          }
        }
      }
    },
    "Used wherever the background is removed: the cutout, and a blurred or replaced background." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم في كل مكان تُزال فيه الخلفية: القص، والخلفية المموهة أو المستبدلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se všude, kde se odstraňuje pozadí: výřez a rozmazané nebo nahrazené pozadí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt überall, wo der Hintergrund entfernt wird: beim Freisteller und bei einem weichgezeichneten oder ersetzten Hintergrund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa siempre que se quita el fondo: el recorte y un fondo desenfocado o reemplazado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé partout où l’arrière-plan est supprimé : le détourage, et un arrière-plan flou ou remplacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato ovunque lo sfondo venga rimosso: il ritaglio e lo sfondo sfocato o sostituito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
