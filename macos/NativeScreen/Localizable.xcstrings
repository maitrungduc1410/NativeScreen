    "Leans with fast horizontal movement, settling back upright at rest." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يميل مع الحركة الأفقية السريعة، ويعود مستقيمًا عند التوقف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při rychlém vodorovném pohybu se nakloní a v klidu se zase narovná."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neigt sich bei schneller horizontaler Bewegung und richtet sich im Stillstand wieder auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inclina con el movimiento horizontal rápido y vuelve a ponerse recto en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’incline lors des mouvements horizontaux rapides et se redresse au repos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si inclina con i movimenti orizzontali veloci e torna dritto a riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "速い横の動きで傾き、止まるとまっすぐに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 가로 움직임에 기울고, 멈추면 다시 똑바로 섭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclina com movimentos horizontais rápidos e volta a ficar reto em repouso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наклоняется при быстром движении по горизонтали и выпрямляется в покое."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlı yatay harekette eğilir, dururken yeniden dikleşir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghiêng theo chuyển động ngang nhanh, trở lại thẳng đứng khi dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速水平移动时倾斜，静止时回正。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速水平移動時傾斜，靜止時回正。"
          }
        }
      }
    },
