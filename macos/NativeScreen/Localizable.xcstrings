    "The camera did not send any picture, so nothing was recorded." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم ترسل الكاميرا أي صورة، لذلك لم يُسجَّل شيء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera neposlala žádný obraz, takže se nic nenahrálo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera hat kein Bild geliefert, daher wurde nichts aufgenommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara no envió ninguna imagen, así que no se grabó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
