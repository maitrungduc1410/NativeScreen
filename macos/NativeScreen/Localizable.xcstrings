    "Native Screen checks GitHub for a new version once a day and asks before installing it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق Native Screen من GitHub مرة يوميًا بحثًا عن إصدار جديد ويسأل قبل تثبيته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen jednou denně hledá novou verzi na GitHubu a před instalací se zeptá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen sucht einmal am Tag auf GitHub nach einer neuen Version und fragt vor der Installation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen busca una versión nueva en GitHub una vez al día y pregunta antes de instalarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen cherche une nouvelle version sur GitHub une fois par jour et demande avant de l’installer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen controlla GitHub una volta al giorno per una nuova versione e chiede prima di installarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen は 1 日に 1 回 GitHub で新しいバージョンを確認し、インストールする前に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen은 하루에 한 번 GitHub에서 새 버전을 확인하고 설치 전에 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Native Screen procura uma nova versão no GitHub uma vez por dia e pergunta antes de instalá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen раз в день проверяет новую версию на GitHub и спрашивает перед установкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen günde bir kez GitHub'da yeni sürüm olup olmadığına bakar ve yüklemeden önce sorar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen kiểm tra phiên bản mới trên GitHub mỗi ngày một lần và hỏi bạn trước khi cài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen 每天在 GitHub 上检查一次新版本，安装前会先询问你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen 每天在 GitHub 上檢查一次新版本，安裝前會先詢問你。"
          }
        }
      }
    },
    "Native Screen will download the open-source OpenAI Whisper \"%@\" (%@, ~%@) speech recognition model to your Mac:" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيقوم Native Screen بتنزيل نموذج التعرف على الكلام مفتوح المصدر OpenAI Whisper ‏\"%1$@\" ‏(%2$@، ~%3$@) إلى جهاز Mac:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen stáhne do vašeho Macu open-source model rozpoznávání řeči OpenAI Whisper „%1$@“ (%2$@, ~%3$@):"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen lädt das Open-Source-Spracherkennungsmodell OpenAI Whisper „%1$@“ (%2$@, ~%3$@) auf deinen Mac:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen descargará en tu Mac el modelo de reconocimiento de voz de código abierto OpenAI Whisper «%1$@» (%2$@, ~%3$@):"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen va télécharger sur votre Mac le modèle de reconnaissance vocale open source OpenAI Whisper « %1$@ » (%2$@, ~%3$@) :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen scaricherà sul tuo Mac il modello di riconoscimento vocale open source OpenAI Whisper “%1$@” (%2$@, ~%3$@):"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen は、オープンソースの音声認識モデル OpenAI Whisper「%1$@」（%2$@、約 %3$@）をこの Mac にダウンロードします:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen이 오픈 소스 음성 인식 모델 OpenAI Whisper \"%1$@\"(%2$@, 약 %3$@)을(를) Mac에 다운로드합니다:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Native Screen vai baixar no seu Mac o modelo de reconhecimento de fala de código aberto OpenAI Whisper “%1$@” (%2$@, ~%3$@):"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen загрузит на ваш Mac открытую модель распознавания речи OpenAI Whisper «%1$@» (%2$@, ~%3$@):"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen, açık kaynaklı OpenAI Whisper \"%1$@\" (%2$@, ~%3$@) konuşma tanıma modelini Mac'inize indirecek:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen sẽ tải mô hình nhận dạng giọng nói mã nguồn mở OpenAI Whisper \"%1$@\" (%2$@, ~%3$@) về máy Mac của bạn:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen 将把开源语音识别模型 OpenAI Whisper“%1$@”（%2$@，约 %3$@）下载到你的 Mac："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen 將把開放原始碼語音辨識模型 OpenAI Whisper「%1$@」（%2$@，約 %3$@）下載到你的 Mac："
          }
        }
      }
    },
