    "Evened-out skin, gentle filmic contrast, warm-vs-cool separation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بشرة متجانسة وتباين سينمائي لطيف وفصل بين الدافئ والبارد"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyrovnaná pleť, jemný filmový kontrast, oddělení teplé a studené"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeglichene Haut, sanfter filmischer Kontrast, Trennung von warm und kalt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piel uniforme, contraste suave de cine, separación entre cálidos y fríos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peau unifiée, contraste filmique doux, séparation chaud-froid"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelle uniforme, contrasto filmico delicato, separazione caldo/freddo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均一な肌、穏やかなフィルム調コントラスト、暖色と寒色の分離"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 피부, 은은한 필름 대비, 따뜻함과 차가움의 분리"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pele uniforme, contraste suave de cinema, separação entre quente e frio"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ровная кожа, мягкий киношный контраст, разделение тёплого и холодного"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşit ten, yumuşak filmsel kontrast, sıcak-soğuk ayrımı"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da đều màu, tương phản nhẹ kiểu phim, tách bạch tông ấm và lạnh"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肤色均匀，柔和的胶片对比，冷暖分明"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "膚色均勻，柔和的底片對比，冷暖分明"
          }
        }
      }
    },
    "Every edit an agent makes shows in the editor and can be undone with ⌘Z. Recording shows the recording bar and its countdown. A deleted project goes to the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل تعديل يجريه وكيل يظهر في المحرر ويمكن التراجع عنه بـ ⌘Z. يعرض التسجيل شريط التسجيل والعد التنازلي. ينتقل المشروع المحذوف إلى سلة المهملات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá úprava agenta se zobrazí v editoru a lze ji vrátit klávesami ⌘Z. Při nahrávání se zobrazí panel nahrávání a odpočet. Smazaný projekt se přesune do koše."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Änderung eines Agenten erscheint im Editor und lässt sich mit ⌘Z widerrufen. Bei Aufnahmen erscheinen die Aufnahmeleiste und der Countdown. Ein gelöschtes Projekt landet im Papierkorb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cambio de un agente se ve en el editor y se puede deshacer con ⌘Z. Al grabar se muestran la barra de grabación y su cuenta atrás. Un proyecto eliminado va a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque modification d’un agent apparaît dans l’éditeur et peut être annulée avec ⌘Z. L’enregistrement affiche la barre d’enregistrement et son compte à rebours. Un projet supprimé va dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni modifica di un agente appare nell'editor e si può annullare con ⌘Z. La registrazione mostra la barra di registrazione e il conto alla rovescia. Un progetto eliminato va nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントの編集はすべてエディタに表示され、⌘Z で取り消せます。収録中は収録バーとカウントダウンが表示されます。削除したプロジェクトはゴミ箱に入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 한 모든 편집은 편집기에 표시되며 ⌘Z로 취소할 수 있습니다. 녹화 시 녹화 막대와 카운트다운이 표시됩니다. 삭제한 프로젝트는 휴지통으로 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada edição de um agente aparece no editor e pode ser desfeita com ⌘Z. A gravação mostra a barra de gravação e a contagem regressiva. Um projeto apagado vai para o Lixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая правка агента видна в редакторе и отменяется через ⌘Z. При записи показываются панель записи и обратный отсчёт. Удалённый проект попадает в Корзину."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ajanın yaptığı her düzenleme düzenleyicide görünür ve ⌘Z ile geri alınabilir. Kayıt sırasında kayıt çubuğu ve geri sayım gösterilir. Silinen proje Çöp Sepeti'ne gider."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thay đổi của agent đều hiện trong editor và hoàn tác được bằng ⌘Z. Khi quay, thanh quay và đếm ngược vẫn hiện. Project bị xoá sẽ vào Thùng rác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理所做的每项编辑都会显示在编辑器中，并可用 ⌘Z 撤销。录制时会显示录制栏和倒计时。删除的项目会移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理程式所做的每項編輯都會顯示在編輯器中，並可用 ⌘Z 還原。錄製時會顯示錄製列和倒數。刪除的專案會移到垃圾桶。"
          }
        }
      }
    },
