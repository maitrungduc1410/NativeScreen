    "While keyframes exist, moving the item on the preview changes the keyframe at the playhead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما دامت هناك إطارات رئيسية، فإن تحريك العنصر في المعاينة يغيّر الإطار الرئيسي عند رأس التشغيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokud existují klíčové snímky, přesunutí prvku v náhledu změní klíčový snímek na ukazateli."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange es Keyframes gibt, ändert das Verschieben in der Vorschau den Keyframe am Abspielkopf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras haya fotogramas clave, mover el elemento en la vista previa cambia el fotograma clave del cabezal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant qu’il y a des images clés, déplacer l’élément dans l’aperçu modifie l’image clé à la tête de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché esistono keyframe, spostare l'elemento nell'anteprima modifica il keyframe sulla testina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーフレームがある間は、プレビューで動かすと再生ヘッド位置のキーフレームが変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키프레임이 있는 동안 미리보기에서 항목을 옮기면 재생 헤드의 키프레임이 바뀝니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto houver quadros-chave, mover o item na pré-visualização altera o quadro-chave no cursor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока есть ключевые кадры, перемещение элемента в превью меняет ключевой кадр на указателе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtar kareler varken öğeyi önizlemede taşımak, oynatma kafasındaki anahtar kareyi değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đã có keyframe, kéo chú thích trên bản xem trước sẽ sửa keyframe tại playhead."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在关键帧时，在预览中移动该项会修改播放头处的关键帧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有關鍵影格時，在預覽中移動項目會修改播放磁頭處的關鍵影格。"
          }
        }
      }
    },
