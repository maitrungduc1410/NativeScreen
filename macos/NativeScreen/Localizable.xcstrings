    "Native Screen checks GitHub for a new version once a day and asks before installing it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen sucht einmal am Tag auf GitHub nach einer neuen Version und fragt vor der Installation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen busca una versión nueva en GitHub una vez al día y pregunta antes de instalarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen cherche une nouvelle version sur GitHub une fois par jour et demande avant de l’installer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen は 1 日に 1 回 GitHub で新しいバージョンを確認し、インストールする前に確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Native Screen procura uma nova versão no GitHub uma vez por dia e pergunta antes de instalá-la."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen kiểm tra phiên bản mới trên GitHub mỗi ngày một lần và hỏi bạn trước khi cài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Screen 每天在 GitHub 上检查一次新版本，安装前会先询问你。"
          }
        }
      }
    },
