    },
    "Transcript will be generated locally using Apple's native speech recognition engine. No data will be sent to any server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُنشأ النص محليًا باستخدام محرك التعرف على الكلام الأصلي من Apple. لن تُرسل أي بيانات إلى أي خادم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepis se vytvoří místně nativním rozpoznáváním řeči od Applu. Žádná data se neposílají na server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Transkript wird lokal mit der Spracherkennung von Apple erstellt. Es werden keine Daten an einen Server gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcripción se genera en local con el motor de reconocimiento de voz de Apple. No se envía ningún dato a ningún servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcription est générée localement par le moteur de reconnaissance vocale d’Apple. Aucune donnée n’est envoyée à un serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La trascrizione verrà generata localmente con il motore di riconoscimento vocale nativo di Apple. Nessun dato verrà inviato a server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こしは Apple 純正の音声認識エンジンを使ってこの Mac 上で生成されます。データがサーバに送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대본은 Apple의 기본 음성 인식 엔진으로 로컬에서 생성됩니다. 어떤 서버에도 데이터를 보내지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transcrição será gerada localmente pelo mecanismo de reconhecimento de fala da Apple. Nenhum dado é enviado a servidores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифровка создаётся локально встроенным распознаванием речи Apple. Данные на серверы не отправляются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin dökümü, Apple'ın yerleşik konuşma tanıma motoruyla yerel olarak oluşturulur. Hiçbir sunucuya veri gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcript được tạo ngay trên máy bằng công cụ nhận dạng giọng nói của Apple. Không có dữ liệu nào gửi lên máy chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字稿将使用 Apple 原生语音识别引擎在本机生成。不会向任何服务器发送数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐字稿會使用 Apple 原生語音辨識引擎在本機產生。不會傳送任何資料到伺服器。"
          }
        }
      }
    },
    "Transcripts run on this device. The model is downloaded once from huggingface.co; your audio is never uploaded." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل النسخ على هذا الجهاز. يُنزَّل النموذج مرة واحدة من huggingface.co، ولا يُرفع صوتك أبدًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepis běží na tomto zařízení. Model se jednou stáhne z huggingface.co; váš zvuk se nikdy nenahrává."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkripte entstehen auf diesem Gerät. Das Modell wird einmal von huggingface.co geladen; dein Ton wird nie hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transcripciones se hacen en este dispositivo. El modelo se descarga una vez desde huggingface.co; tu audio nunca se sube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transcriptions se font sur cet appareil. Le modèle est téléchargé une fois depuis huggingface.co ; votre audio n’est jamais envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trascrizioni avvengono su questo dispositivo. Il modello viene scaricato una volta da huggingface.co; l’audio non viene mai caricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こしはこのデバイス上で行われます。モデルは huggingface.co から一度だけダウンロードされ、音声がアップロードされることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전사는 이 기기에서 실행됩니다. 모델은 huggingface.co에서 한 번만 다운로드되며 오디오는 업로드되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As transcrições são feitas neste dispositivo. O modelo é baixado uma vez de huggingface.co; seu áudio nunca é enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расшифровка выполняется на этом устройстве. Модель загружается один раз с huggingface.co, звук никуда не отправляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döküm bu cihazda yapılır. Model huggingface.co adresinden bir kez indirilir; sesiniz asla yüklenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản chép lời được tạo ngay trên máy này. Mô hình được tải một lần từ huggingface.co; âm thanh của bạn không bao giờ bị tải lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转写在本设备上进行。模型从 huggingface.co 下载一次，你的音频绝不会上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉錄在本裝置上進行。模型從 huggingface.co 下載一次，你的音訊絕不會上傳。"
          }
        }
      }
    },
