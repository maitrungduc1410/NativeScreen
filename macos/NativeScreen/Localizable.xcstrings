    "Save project changes automatically. When off, save with ⌘S; closing a project with unsaved changes asks first." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ تغييرات المشروع تلقائيًا. عند الإيقاف، احفظ بـ ⌘S؛ وسيُطلب منك التأكيد عند إغلاق مشروع به تغييرات غير محفوظة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky ukládat změny projektu. Je-li vypnuto, ukládejte klávesami ⌘S; při zavírání projektu s neuloženými změnami se nejdřív zeptá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektänderungen automatisch sichern. Wenn aus, mit ⌘S sichern; beim Schließen eines Projekts mit ungesicherten Änderungen wird zuerst gefragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda automáticamente los cambios del proyecto. Si está desactivado, guarda con ⌘S; al cerrar un proyecto con cambios sin guardar se pregunta antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre automatiquement les modifications du projet. Si désactivé, enregistrez avec ⌘S ; la fermeture d’un projet non enregistré demande d’abord confirmation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva automaticamente le modifiche del progetto. Se disattivato, salva con ⌘S; chiudendo un progetto con modifiche non salvate verrà chiesto prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトの変更を自動で保存します。オフのときは ⌘S で保存します。未保存の変更があるプロジェクトを閉じるときは確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 변경 사항을 자동으로 저장합니다. 끄면 ⌘S로 저장하며, 저장하지 않은 변경 사항이 있는 프로젝트를 닫을 때 먼저 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva as alterações do projeto automaticamente. Quando desativado, salve com ⌘S; ao fechar um projeto com alterações não salvas, você é avisado antes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически сохранять изменения проекта. Если выключено, сохраняйте через ⌘S; при закрытии проекта с несохранёнными изменениями будет запрос."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proje değişikliklerini otomatik kaydet. Kapalıyken ⌘S ile kaydedin; kaydedilmemiş değişiklikleri olan bir projeyi kapatırken önce sorulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động lưu thay đổi của dự án. Khi tắt, hãy lưu bằng ⌘S; đóng dự án có thay đổi chưa lưu sẽ được hỏi trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动存储项目更改。关闭时请用 ⌘S 存储；关闭有未存储更改的项目时会先询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動儲存專案變更。關閉時請用 ⌘S 儲存；關閉有未儲存變更的專案時會先詢問。"
          }
        }
      }
    },
