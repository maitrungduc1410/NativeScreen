    "Upcoming words are shown dimmed and light up when spoken." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الكلمات القادمة باهتة وتضيء عند نطقها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadcházející slova jsou ztlumená a rozsvítí se, když zazní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommende Wörter werden abgedunkelt gezeigt und leuchten beim Sprechen auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras siguientes se ven atenuadas y se iluminan al decirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots à venir sont atténués et s’illuminent quand ils sont prononcés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le parole successive appaiono attenuate e si accendono quando vengono pronunciate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これから話される単語は薄く表示され、話されると明るくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 단어는 흐리게 표시되다가 말할 때 밝아집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As próximas palavras aparecem esmaecidas e se acendem ao serem faladas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующие слова показываются приглушённо и подсвечиваются при произнесении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıradaki kelimeler soluk görünür ve söylendiklerinde parlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các từ sắp tới hiện mờ và sáng lên khi được nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即将出现的字词先暗显，说出时点亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即將出現的字詞先變暗，說出時亮起。"
          }
        }
      }
    },
