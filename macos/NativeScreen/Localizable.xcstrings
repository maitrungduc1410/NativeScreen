    "What happens when you stop a recording." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يحدث عند إيقاف التسجيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co se stane, když zastavíte nahrávání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was passiert, wenn du eine Aufnahme stoppst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué ocurre al detener una grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui se passe quand vous arrêtez un enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa succede quando interrompi una registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録を停止したときの動作。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화를 중지하면 일어나는 일."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que acontece quando você para uma gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что происходит при остановке записи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kaydı durdurduğunuzda ne olacağı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều gì xảy ra khi bạn dừng quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止录制时会发生什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止錄製時會發生什麼。"
          }
        }
      }
    },
    "When disabled, this shortcut segment is dimmed on the timeline and hidden in the video." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التعطيل، يظهر جزء هذا الاختصار باهتًا في المخطط الزمني ومخفيًا في الفيديو."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li vypnuto, je tento úsek zkratky na časové ose ztlumený a ve videu skrytý."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, wird dieser Kurzbefehl-Abschnitt in der Timeline abgedunkelt und im Video ausgeblendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, este fragmento de atajo se atenúa en la línea de tiempo y se oculta en el vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois désactivé, ce segment de raccourci est atténué dans la timeline et masqué dans la vidéo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, questo segmento di scorciatoia è attenuato nella timeline e nascosto nel video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効にすると、このショートカットのセグメントはタイムライン上で薄く表示され、ビデオでは非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 이 단축키 구간이 타임라인에서 흐리게 표시되고 동영상에서 숨겨집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativado, este trecho de atalho fica esmaecido na linha do tempo e oculto no vídeo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключено, этот фрагмент сочетания приглушён на таймлайне и скрыт в видео."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken bu kısayol bölümü zaman çizelgesinde soluk görünür ve videoda gizlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tắt, đoạn phím tắt này hiện mờ trên timeline và bị ẩn trong video."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用后，此快捷键片段在时间线上变暗，并在视频中隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用後，此快速鍵片段在時間軸上會變暗，並在影片中隱藏。"
          }
        }
      }
    },
    "When enabled, the original microphone and webcam recording will be hidden and muted while the voiceover is playing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، يُخفى تسجيل الميكروفون وكاميرا الويب الأصلي ويُكتم أثناء تشغيل التعليق الصوتي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, původní záznam mikrofonu a webkamery se během komentáře skryje a ztlumí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Mikrofon und Webcam der Originalaufnahme ausgeblendet und stummgeschaltet, solange das Voiceover läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, el micrófono y la webcam de la grabación original se ocultan y silencian mientras suena la voz en off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activé, le micro et la webcam de l’enregistrement d’origine sont masqués et coupés pendant la lecture de la voix off."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, la registrazione originale di microfono e webcam viene nascosta e silenziata mentre suona la voce fuori campo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、ナレーションの再生中は元の収録のマイクとウェブカメラが隠され、ミュートされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 보이스오버가 재생되는 동안 원본 마이크와 웹캠 녹화가 숨겨지고 음소거됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o microfone e a webcam da gravação original ficam ocultos e mudos enquanto a narração toca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, исходная запись микрофона и веб-камеры скрывается и заглушается, пока звучит закадровый голос."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıkken seslendirme çalarken orijinal mikrofon ve web kamerası kaydı gizlenir ve sesi kapatılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, micro và webcam của bản ghi gốc sẽ bị ẩn và tắt tiếng trong lúc thuyết minh phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，在旁白播放期间，原始录制的麦克风和摄像头将被隐藏并静音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，在旁白播放期間，原始錄製的麥克風和網路攝影機會被隱藏並靜音。"
          }
        }
      }
    },
    "When re-generating transcript, previous transcript (and all changes you made to it) will be lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إعادة إنشاء النص، سيُفقد النص السابق (وكل التغييرات التي أجريتها عليه)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při novém vytvoření přepisu se předchozí přepis (i všechny vaše změny) ztratí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim erneuten Erstellen des Transkripts geht das vorherige Transkript (und alle deine Änderungen daran) verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al volver a generar la transcripción, la anterior (y todos los cambios que le hiciste) se perderá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En régénérant la transcription, la transcription précédente (et toutes vos modifications) sera perdue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rigenerando la trascrizione, quella precedente (e tutte le modifiche fatte) andrà persa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こしを再生成すると、以前の文字起こし（とそれに加えたすべての変更）は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대본을 다시 생성하면 이전 대본(과 수정한 모든 내용)이 사라집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao gerar a transcrição de novo, a transcrição anterior (e todas as alterações feitas nela) será perdida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При повторном создании расшифровки прежняя (со всеми вашими правками) будет потеряна."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin dökümü yeniden oluşturulduğunda önceki döküm (ve yaptığınız tüm değişiklikler) kaybolur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tạo lại transcript, transcript cũ (cùng mọi chỉnh sửa của bạn trên nó) sẽ mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新生成文字稿时，之前的文字稿（以及你对它的所有修改）将会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新產生逐字稿時，之前的逐字稿（以及你對它的所有修改）將會遺失。"
          }
        }
      }
    },
    "When something lights up under the moving mouse, like a menu item or a button, the cursor gets there just in time, setting off a little earlier or moving a little faster, so the highlight never shows before the cursor does." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يضيء شيء تحت الماوس المتحرك، مثل عنصر قائمة أو زر، يصل المؤشر إليه في الوقت المناسب تمامًا، فينطلق أبكر قليلًا أو يتحرك أسرع قليلًا، فلا يظهر الإبراز أبدًا قبل المؤشر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se pod pohybující se myší něco rozsvítí, třeba položka nabídky nebo tlačítko, kurzor tam dorazí právě včas, vyrazí o chvilku dřív nebo pojede o něco rychleji, takže zvýraznění se nikdy neukáže dřív než kurzor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn unter der bewegten Maus etwas aufleuchtet, etwa ein Menüpunkt oder eine Taste, kommt der Cursor genau rechtzeitig an, weil er etwas früher losfährt oder etwas schneller wird. So erscheint die Hervorhebung nie vor dem Cursor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando algo se ilumina bajo el ratón en movimiento, como un elemento de menú o un botón, el cursor llega justo a tiempo, saliendo un poco antes o yendo un poco más rápido, para que el resaltado nunca aparezca antes que el cursor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelque chose s’allume sous la souris en mouvement, comme un élément de menu ou un bouton, le curseur y arrive juste à temps, en partant un peu plus tôt ou en allant un peu plus vite, pour que la surbrillance n’apparaisse jamais avant lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando qualcosa si illumina sotto il mouse in movimento, come una voce di menu o un pulsante, il cursore ci arriva giusto in tempo, partendo un po' prima o muovendosi un po' più veloce, così l'evidenziazione non appare mai prima del cursore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動くマウスの下でメニュー項目やボタンなどが光るとき、カーソルは少し早めに動き出すか少し速く動いてちょうど間に合うように到着するため、ハイライトがカーソルより先に表示されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직이는 마우스 아래에서 메뉴 항목이나 버튼처럼 무언가가 밝아지면, 커서가 조금 일찍 출발하거나 조금 더 빨리 움직여 딱 맞게 도착하므로 커서보다 강조가 먼저 보이는 일이 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando algo se acende sob o mouse em movimento, como um item de menu ou um botão, o cursor chega na hora certa, saindo um pouco antes ou indo um pouco mais rápido, para que o destaque nunca apareça antes do cursor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда под движущейся мышью что-то подсвечивается, например пункт меню или кнопка, курсор успевает туда вовремя, выходя чуть раньше или двигаясь чуть быстрее, так что подсветка никогда не появляется раньше курсора."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket eden farenin altında menü öğesi veya düğme gibi bir şey parladığında imleç oraya tam zamanında varır; biraz erken yola çıkar ya da biraz hızlı gider, böylece vurgu asla imleçten önce görünmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi có thứ sáng lên dưới con chuột đang di chuyển, như một mục menu hay nút bấm, con trỏ sẽ tới đó vừa kịp lúc, khởi hành sớm hơn hoặc đi nhanh hơn một chút, để hiệu ứng sáng không bao giờ hiện trước con trỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当移动的鼠标下方有东西亮起，例如菜单项或按钮，光标会恰好及时到达：稍早出发或移动得稍快一点，让高亮永远不会先于光标出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當移動的滑鼠下方有東西亮起，例如選單項目或按鈕，游標會剛好及時抵達：稍早出發或移動得稍快一點，讓醒目效果永遠不會比游標先出現。"
          }
        }
      }
    },
    "When zooming in, the camera will shrink to avoid covering the recording itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التكبير، تصغر الكاميرا حتى لا تغطي التسجيل نفسه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při přiblížení se kamera zmenší, aby nezakrývala samotný záznam."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Hineinzoomen wird die Kamera kleiner, damit sie die Aufnahme nicht verdeckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al acercar el zoom, la cámara se encoge para no tapar la propia grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors d’un zoom avant, la caméra rétrécit pour ne pas masquer l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante lo zoom la fotocamera si rimpicciolisce per non coprire la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ズームイン時にカメラが小さくなり、収録内容を覆わないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줌할 때 카메라가 작아져 녹화 화면을 가리지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aproximar, a câmera diminui para não cobrir a própria gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При зуме камера уменьшается, чтобы не закрывать саму запись."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakınlaştırırken kamera, kaydın üstünü kapatmamak için küçülür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi zoom vào, camera sẽ thu nhỏ lại để không che nội dung đang quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大时，摄像头会缩小以免遮挡录制内容本身。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大時，相機會縮小以免遮住錄製內容本身。"
          }
        }
      }
    },
