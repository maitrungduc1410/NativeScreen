    "By default, only 2+ keys shortcuts are shown. Enable this option to show single letter shortcuts as well." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتراضيًا، تُعرض فقط الاختصارات المكونة من مفتاحين أو أكثر. فعّل هذا الخيار لعرض اختصارات الحرف الواحد أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve výchozím stavu se zobrazují jen zkratky se 2 a více klávesami. Zapněte, chcete-li zobrazovat i jednopísmenné zkratky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig werden nur Kurzbefehle mit 2 oder mehr Tasten gezeigt. Aktiviere diese Option, um auch Kurzbefehle mit einem Buchstaben zu zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por omisión solo se muestran los atajos de 2 o más teclas. Activa esta opción para mostrar también los de una sola letra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, seuls les raccourcis de 2 touches ou plus sont affichés. Activez cette option pour afficher aussi les raccourcis d’une seule lettre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita vengono mostrate solo le scorciatoie con 2 o più tasti. Attiva questa opzione per mostrare anche quelle con una sola lettera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは 2 キー以上のショートカットのみ表示されます。このオプションを有効にすると、1 文字のショートカットも表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 2개 이상의 키로 된 단축키만 표시됩니다. 한 글자 단축키도 표시하려면 이 옵션을 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, só atalhos com 2 ou mais teclas são mostrados. Ative esta opção para mostrar também atalhos de uma só letra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию показываются только сочетания из 2 и более клавиш. Включите, чтобы показывать и одиночные клавиши."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak yalnızca 2+ tuşlu kısayollar gösterilir. Tek harfli kısayolları da göstermek için bu seçeneği açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định chỉ hiện phím tắt từ 2 phím trở lên. Bật tùy chọn này để hiện cả phím tắt một chữ cái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认只显示 2 个及以上按键的快捷键。启用此选项可同时显示单个字母的快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設只顯示 2 個以上按鍵的快速鍵。開啟此選項可同時顯示單一字母的快速鍵。"
          }
        }
      }
    },
