    "GIF files are much larger than MP4 files. Use MP4 when you can." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIF-Dateien sind viel größer als MP4-Dateien. Verwende MP4, wenn möglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos GIF son mucho más grandes que los MP4. Usa MP4 siempre que puedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers GIF sont bien plus lourds que les MP4. Utilisez le MP4 quand c’est possible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GIF ファイルは MP4 よりずっと大きくなります。できるだけ MP4 を使ってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
