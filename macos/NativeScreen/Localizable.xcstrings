    "Edit your video by editing its text: delete words to cut them out, remove filler words and long pauses in one click." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّر الفيديو بتحرير نصه: احذف الكلمات لقصها، وأزل كلمات الحشو والوقفات الطويلة بنقرة واحدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravujte video úpravou textu: smazáním slov je vystřihnete, výplňová slova a dlouhé pauzy odstraníte jedním kliknutím."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite dein Video, indem du den Text bearbeitest: Lösche Wörter, um sie herauszuschneiden, und entferne Füllwörter und lange Pausen mit einem Klick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita tu vídeo editando su texto: borra palabras para cortarlas y quita muletillas y pausas largas con un clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montez votre vidéo en modifiant son texte : supprimez des mots pour les couper, retirez les mots de remplissage et les longues pauses en un clic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica il video modificandone il testo: elimina parole per tagliarle, rimuovi intercalari e pause lunghe con un clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストを編集してビデオを編集：単語を削除するとその部分がカットされ、フィラーや長い間をワンクリックで取り除けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트를 고쳐 동영상을 편집하세요. 단어를 지우면 잘리고, 군말과 긴 휴지는 한 번의 클릭으로 제거됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edite o vídeo editando o texto: apague palavras para cortá-las e remova palavras de preenchimento e pausas longas com um clique."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монтируйте видео, редактируя текст: удаляйте слова, чтобы вырезать их, убирайте слова-паразиты и длинные паузы одним щелчком."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videonuzu metnini düzenleyerek düzenleyin: kelimeleri silerek kesin, dolgu kelimeleri ve uzun duraksamaları tek tıkla kaldırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sửa video bằng cách sửa chữ: xóa từ để cắt chúng đi, bỏ từ đệm và khoảng lặng dài chỉ với một cú bấm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过编辑文字来编辑视频：删除字词即可剪掉对应部分，一键移除填充词和长时间停顿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過編輯文字來編輯影片：刪除字詞即可剪掉對應片段，一鍵移除贅詞和長停頓。"
          }
        }
      }
    },
