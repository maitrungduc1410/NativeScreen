    },
    "Animation is more fluid. Great for more creative content not focused on reading" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحركة أكثر انسيابية. مناسبة للمحتوى الإبداعي الذي لا يركز على القراءة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animace je plynulejší. Hodí se pro kreativnější obsah, který není o čtení"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Animation ist fließender. Ideal für kreativere Inhalte, bei denen es nicht ums Lesen geht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La animación es más fluida. Ideal para contenido creativo que no se centra en la lectura"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’animation est plus fluide. Idéal pour un contenu plus créatif, moins axé sur la lecture"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’animazione è più fluida. Ottima per contenuti creativi non incentrati sulla lettura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アニメーションがより滑らかです。読むことが主ではないクリエイティブな内容に最適です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애니메이션이 더 부드럽습니다. 읽기보다 창의적인 콘텐츠에 잘 맞습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A animação é mais fluida. Ótima para conteúdo criativo que não é focado em leitura"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анимация плавнее. Подходит для творческого контента, где не нужно много читать"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animasyon daha akıcıdır. Okumaya odaklanmayan yaratıcı içerikler için idealdir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển động mượt hơn. Hợp với nội dung sáng tạo, không tập trung vào việc đọc"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动画更流畅，适合不以阅读为主的创意内容"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動畫更流暢，適合不以閱讀為主的創意內容"
          }
        }
      }
    },
