    "Fills a 9:16 frame and follows your face, for shorts and reels." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يملأ إطار 9:16 ويتبع وجهك، للمقاطع القصيرة والريلز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyplní snímek 9:16 a sleduje váš obličej, pro shorts a reels."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt ein 9:16-Bild und folgt deinem Gesicht, für Shorts und Reels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llena un encuadre 9:16 y sigue tu cara, para shorts y reels."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplit un cadre 9:16 et suit votre visage, pour les shorts et les reels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riempie un fotogramma 9:16 e segue il tuo viso, per shorts e reels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9:16 のフレームを埋め、顔を追いかけます。ショート動画やリールに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9:16 프레임을 채우고 얼굴을 따라갑니다. 쇼츠와 릴스용입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preenche um quadro 9:16 e acompanha seu rosto, para shorts e reels."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заполняет кадр 9:16 и следует за лицом. Для Shorts и Reels."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9:16 kareyi doldurur ve yüzünüzü takip eder; Shorts ve Reels için."
          }
        },
        "vi" : {
