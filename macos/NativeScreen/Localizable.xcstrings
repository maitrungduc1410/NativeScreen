    "Better quality to file size ratio than H.264. Not every player can open it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسبة جودة إلى حجم ملف أفضل من H.264. لا تفتحه كل المشغلات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepší poměr kvality a velikosti než H.264. Neotevře ho každý přehrávač."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besseres Verhältnis von Qualität zu Dateigröße als H.264. Nicht jeder Player kann es öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor relación calidad/tamaño que H.264. No todos los reproductores pueden abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleur rapport qualité/taille que le H.264. Tous les lecteurs ne savent pas l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miglior rapporto qualità/dimensione rispetto a H.264. Non tutti i lettori lo aprono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 より画質とファイルサイズの比率に優れています。すべてのプレーヤーで開けるわけではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264보다 화질 대비 파일 크기 비율이 좋습니다. 일부 플레이어에서는 열리지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relação qualidade/tamanho melhor que a do H.264. Nem todo player consegue abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучшее соотношение качества и размера, чем у H.264. Открывается не во всех плеерах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264'ten daha iyi kalite/dosya boyutu oranı. Her oynatıcı açamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tỉ lệ chất lượng trên dung lượng tốt hơn H.264. Không phải trình phát nào cũng mở được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "质量与文件大小之比优于 H.264。并非所有播放器都能打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "品質與檔案大小之比優於 H.264。並非所有播放器都能開啟。"
          }
        }
      }
