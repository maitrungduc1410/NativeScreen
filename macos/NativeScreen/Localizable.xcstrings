    "Shorten every long pause, keeping a natural breath on each side" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقصير كل وقفة طويلة مع ترك نَفَس طبيعي على كل جانب"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkrátit každou dlouhou pauzu a nechat na obou stranách přirozený nádech"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle langen Pausen kürzen und auf jeder Seite einen natürlichen Atemzug lassen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acortar todas las pausas largas, dejando una respiración natural a cada lado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcir toutes les longues pauses en gardant une respiration naturelle de chaque côté"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accorcia ogni pausa lunga, lasciando un respiro naturale su ogni lato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い間をすべて短くし、前後に自然な息継ぎを残す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 긴 휴지를 줄이고 양쪽에 자연스러운 숨을 남깁니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encurtar todas as pausas longas, deixando uma respiração natural de cada lado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сократить каждую длинную паузу, оставив естественный вдох с каждой стороны"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her uzun duraksamayı kısalt, her iki yanda doğal bir nefes bırak"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rút ngắn mọi khoảng lặng dài, chừa một nhịp thở tự nhiên ở hai bên"
          }
        },
        "zh-Hans" : {
