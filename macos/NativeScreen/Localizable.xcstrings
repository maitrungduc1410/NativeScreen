    "Adjusts your voice to a consistent volume. Its character stays the same." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط صوتك على مستوى ثابت. تبقى نبرته كما هي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Srovná hlasitost vašeho hlasu. Jeho charakter zůstane stejný."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringt deine Stimme auf eine gleichmäßige Lautstärke. Ihr Charakter bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta tu voz a un volumen constante. Su carácter se mantiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramène votre voix à un volume constant. Son caractère reste le même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta la tua voce a un volume costante. Il suo carattere resta lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声を一定の音量に整えます。声の質感はそのままです。"
