# Shared by every platform. Platform-specific rules live next to each app (e.g. macos/.gitignore).

# OS files
.DS_Store
._*
Thumbs.db
desktop.ini

# Sample / test recordings. Conformance packages under conformance/ stay tracked.
*.nativescreen/**
!conformance/**/*.nativescreen/**
*.mp4
*.mov
*.m4s
*.m3u8
# Website demos are tracked.
!site/public/assets/**/*.mp4

# Python (tools/)
__pycache__/
*.pyc
tools/demo-driver/build/
